#!/bin/bash





rm ~/.cache/shock-tmp/shock-os-imager/*

until [[ -f ~/.cache/shock-tmp/shock-os-imager/metainfo ]]
do

    wget --timeout 5 https://raw.githubusercontent.com/Shock-OS/Shock-OS/imager/metainfo -P ~/.cache/shock-tmp/shock-os-imager/

    if [[ ! -f ~/.cache/shock-tmp/shock-os-imager/metainfo ]]
    then

        yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="Shock OS Imager requires an internet connection to continue. Please ensure internet connectivity and try again." --buttons-layout=edge --button="Close"\!gtk-close:1 --button="Retry"\!edit-undo:0

        ex=$?

        if [[ "$ex" != "0" ]]
        then

            exit

        fi

    fi

done

function refresh() {

source ~/.cache/shock-tmp/shock-os-imager/metainfo

version=''

edition=''

arch=''

device=''

}

refresh

while true
do

    drives=($(lsblk | grep /media | grep -oP "(sd[a-z]|mmcblk[0-9])" | awk '{print "/dev/"$1}' | sort -u))

    drives_selection=""

    for drive in "${drives[@]}"
    do

        drive_label=""

        for num in {1..1000}
        do

            part_label=""

            if [[ "$drive" == "/dev/mmcblk"* ]]
            then

                part_label="$(lsblk --output LABEL "${drive}p${num}")"

            else

                part_label="$(lsblk --output LABEL "${drive}${num}")"

            fi

            part_label="${part_label:6}" #Removes leading 'LABEL ' from part_label

            if [[ -z "$part_label" ]]
            then

                break

            elif [[ -z "$drive_label" ]]
            then

                drive_label="$part_label"

            else

                drive_label+=", $part_label"

            fi

        done

        if [[ -z "$drive_label" ]]
        then

            drive_label="NO LABEL"

        fi

        if [[ "$device" == "$drive" ]]
        then

            drive="^${drive}"

        fi

        if [[ -z "$drives_selection" ]]
        then

            drives_selection="$drive ($drive_label)"

        else

            drives_selection+='!'"$drive ($drive_label)"

        fi

    done

    versions_yad_cb=""

    for item in "${versions[@]}"
    do

        if [[ "$version" == "$item" ]]
        then

            item="^${item}"

        fi

        if [[ -z "$versions_yad_cb" ]]
        then

            versions_yad_cb+="$item"

        else

            versions_yad_cb+="!${item}"

        fi

    done

    if [[ "$edition" == "MATE" ]]
    then

        editions_yad_cb='GNOME!^MATE'

    else

        editions_yad_cb='GNOME!MATE'

    fi

    if [[ "$arch" == "32-bit" ]]
    then

        arches_yad_cb='64-bit!^32-bit'

    else

        arches_yad_cb='64-bit!32-bit'

    fi

    output="$(yad --width=500 --height=280 --window-icon=shock-os-imager --title="Shock OS Imager" --form --always-print-result --field="Version:":LBL '' --field="":CB "$versions_yad_cb" --field="Edition:":LBL '' --field="":CB "$editions_yad_cb" --field="Architecture:":LBL '' --field="":CB "$arches_yad_cb" --field="Storage Device:":LBL '' --field="":CB "$drives_selection" --buttons-layout=spread --button="Options"\!tweaks-app:2 --button="Refresh"\!gtk-refresh:1 --button="Start Flashing"\!gtk-ok:0)"

    ex=$?

    version="$(echo "$output" | awk -F'|' '{print $2}')"

    edition="$(echo "$output" | awk -F'|' '{print $4}')"

    arch="$(echo "$output" | awk -F'|' '{print $6}')"

    device="$(echo "$output" | awk -F'|' '{print $8}')"

    device="${string%% *}"

    if [[ "$ex" == "0" ]] #Flash
    then

        pkexec shock-os-imager-write-image "$version" "$edition" "$arch" "$device"

    elif [[ "$ex" == "1" ]] #Refresh
    then

        refresh

    elif [[ "$ex" == "2" ]] #Options
    then

        if [[ -f /usr/share/shock-os-imager/image-caching-enabled ]]
        then

            caching_enabled="TRUE"

        else

            caching_enabled="FALSE"

        fi

        output="$(yad --width=300 --window-icon=shock-os-imager --title="Options" --form --field="<big><b>Caching Images</b></big>":LBL '' --field="Caching images significantly reduces the amount of time it takes to flash the same image later, but these images also occupy several gigabytes of space. If you flash the same image or images often, and have sufficient space on your computer, caching is recommended. If you rarely use Shock OS Imager and/or don't have enough space on your computer, then we'd recommend disabling caching.":LBL '' --field="Delete Cached Images":FBTN 'shock-os-imager-remove-cached-images' --field="Enable Caching":CHK "$caching_enabled" --buttons-layout=edge --button="Cancel"\!gtk-cancel:1 --button="Apply"\!gtk-ok:0)"

        ex=$?

        caching_enabled="$(echo "$output" | awk -F'|' '{print $4}')"

        if [[ "$ex" == "0" ]]
        then

            if [[ "$caching_enabled" == "TRUE" ]] && [[ ! -f /usr/share/shock-os-imager/image-caching-enabled ]] #Enable caching
            then

                pkexec touch /usr/share/shock-os-imager/image-caching-enabled

            elif [[ "$caching_enabled" == "FALSE" ]] && [[ -f /usr/share/shock-os-imager/image-caching-enabled ]] #Disable caching
            then

                pkexec rm /usr/share/shock-os-imager/image-caching-enabled

            fi

        fi

    else

        exit

    fi

done

    

        

















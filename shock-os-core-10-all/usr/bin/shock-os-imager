#!/bin/bash

tmpdir="$(mktemp -d)"

function refresh() {

source "$tmpdir"/metainfo

version=''

edition=''

arch=''

device=''

}

function cleanup() {

rm -rf "$tmpdir"

}

refresh

while true
do

    rm "$tmpdir"/metainfo

    until [[ -f "$tmpdir"/metainfo ]]
    do

        wget --retry-connrefused --tries=0 --timeout 5 https://raw.githubusercontent.com/Shock-OS/Shock-OS/imager/metainfo -P "$tmpdir"/

        if [[ ! -f "$tmpdir"/metainfo ]]
        then

            yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="Shock OS Imager requires an internet connection to continue. Please ensure internet connectivity and try again." --buttons-layout=edge --button="Close"\!gtk-close:1 --button="Retry"\!edit-undo:0

            ex=$?

            if [[ "$ex" != "0" ]]
            then

                cleanup

                exit

            fi

        fi

    done

    rm "$tmpdir"/key.asc

    rm "$tmpdir"/metainfo.sig

    wget --retry-connrefused --tries=0 --timeout=5 https://raw.githubusercontent.com/Shock-OS/Shock-OS/imager/key.asc -P "$tmpdir"/

    wget --retry-connrefused --tries=0 --timeout 5 https://github.com/Shock-OS/Shock-OS/raw/imager/metainfo.sig -P "$tmpdir"/

    gpg --import "$tmpdir"/key.asc

    gpg --verify "$tmpdir"/metainfo.sig "$tmpdir"/metainfo || { yad --window-icon=shock-os-imager --title="Shock OS Imager" --image=emblem-important-symbolic --text="ERROR: Metainfo could not be verified. Please try again later." --button="Dismiss"\!gtk-close; cleanup; exit 1; }

    source "$tmpdir"/metainfo

    if ((${#versions[@]}==0))
    then

        yad --window-icon=shock-os-imager --title="Shock OS Imager" --image=emblem-important-symbolic --text="ERROR: Could not read metainfo. Please try again later." --button="Dismiss"\!gtk-close

        cleanup

        exit 1

    fi

    drives=($(lsblk | grep /media | grep -oP "(sd[a-z]|mmcblk[0-9])" | awk '{print "/dev/"$1}' | sort -u))

    drives_selection=""

    for drive in "${drives[@]}"
    do

        drive_label=""

        for num in {1..1000}
        do

            part_label=""

            if [[ "$drive" == "/dev/mmcblk"* ]]
            then

                part_label="$(lsblk --output LABEL "${drive}p${num}")"

            else

                part_label="$(lsblk --output LABEL "${drive}${num}")"

            fi

            part_label="${part_label:6}" #Removes leading 'LABEL ' from part_label

            if [[ -z "$part_label" ]]
            then

                break

            elif [[ -z "$drive_label" ]]
            then

                drive_label="$part_label"

            else

                drive_label+=", $part_label"

            fi

        done

        if [[ -z "$drive_label" ]]
        then

            drive_label="NO LABEL"

        fi

        if [[ "$device" == "$drive" ]]
        then

            drive="^${drive}"

        fi

        if [[ -z "$drives_selection" ]]
        then

            drives_selection="$drive ($drive_label)"

        else

            drives_selection+='!'"$drive ($drive_label)"

        fi

    done

    versions_yad_cb=""

    for item in "${versions[@]}"
    do

        if [[ "$version" == "$item" ]]
        then

            item="^${item}"

        fi

        if [[ -z "$versions_yad_cb" ]]
        then

            versions_yad_cb+="$item"

        else

            versions_yad_cb+="!${item}"

        fi

    done

    if [[ "$edition" == "MATE" ]]
    then

        editions_yad_cb='GNOME!^MATE'

    else

        editions_yad_cb='GNOME!MATE'

    fi

    if [[ "$arch" == "32_bit" ]] #Yes, underscore IS correct
    then

        arches_yad_cb='64-bit!^32-bit'

    else

        arches_yad_cb='64-bit!32-bit'

    fi

    output="$(yad --width=500 --height=295 --window-icon=shock-os-imager --title="Shock OS Imager" --form \
                --always-print-result \
                --field="Version:":LBL '' \
                --field="":CB "$versions_yad_cb" \
                --field="Edition:":LBL '' \
                --field="":CB "$editions_yad_cb" \
                --field="Architecture:":LBL '' \
                --field="":CB "$arches_yad_cb" \
                --field="Storage Device:":LBL '' \
                --field="":CB "$drives_selection" \
                --buttons-layout=spread \
                --button="Options"\!tweaks-app:2 --button="Refresh"\!gtk-refresh:1 --button="Start Flashing"\!gtk-ok:0)"

    ex=$?

    version="$(echo "$output" | awk -F'|' '{print $2}')"

    edition="$(echo "$output" | awk -F'|' '{print $4}')"

    arch="$(echo "$output" | awk -F'|' '{print $6}')"

    arch="${arch//-/_}"

    device="$(echo "$output" | awk -F'|' '{print $8}')"

    device="${device%% *}"

    imagevar="${version}_${edition}_${arch}"

    if [[ "$ex" == "0" ]] #Flash
    then

        device_size="$(cat /sys/class/block/$(basename "$device")/size)"

        free_space="$(df -B 1G / | awk 'NR==2 {print $4}')"

        if [[ "$device" == "(null)" ]]
        then

            yad --width=600 --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: No device was selected. Please insert an SD card or USB drive that is at least 16 GBs in space to install Shock OS on." --button="Dismiss"\!gtk-close

        elif ! lsblk "$device" &>/dev/null #if device is no longer connected
        then

            yad --width=600 --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: The device $device does not seem to be plugged in anymore. Please insert an SD card or USB drive that is at least 16 GBs in space to install Shock OS on." --button="Dismiss"\!gtk-close

        elif (($((device_size * 512)) < 12884901888)) #if device is less than 12GB. Using 12GB because it is clearly bigger than 8GB but will allow any 16GB drive.
        then

            yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: The selected device is too small. The target device must be at least 16 GBs in size for Shock OS to work properly. Please try again with a larger SD card or USB drive." --button="Dismiss"\!gtk-close

        elif ((free_space<5)) && [[ ! -f /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" ]] #if less than 5GB of free space on system and image isn't cached
        then

            if (($(ls /usr/share/shock-os-imager/cache/images | wc -l)!=0)) #if cached images
            then

                shock-os-imager-remove-cached-images --nospace

            else

                yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="Your system only has $free_space GBs left of space, which is not sufficient to download an image of Shock OS to flash. Shock OS Imager requires a minimum of 5 GBs of free space to download a new image." --button="Dismiss"\!gtk-close

            fi

        else

            yad --width=500 --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="WARNING: This will ERASE ALL DATA on device ${device}. Are you sure you would like to continue?" --button="No, cancel"\!gtk-cancel:1 --button="Yes, continue"\!go-next:0

            ex=$?

            if [[ "$ex" == "0" ]]
            then

                mkdir -p "$tmpdir"/writer

                rm -rf "$tmpdir"/writer/*

                script -afe "$tmpdir"/writer/output.txt -c "pkexec bash -c '/usr/bin/shock-os-imager-write-image \"$version\" \"$edition\" \"$arch\" \"$device\" \"$tmpdir\"; echo \"\$?\" | tee \"$tmpdir/writer\"/image_writer_ex'" || touch "$tmpdir"/writer/cancelled_indicator & image_writer_pid=$!

                { inotifywait -m -e create "$tmpdir/writer" & echo $! | tee "$tmpdir"/writer/inotifywait_pid; } | while read -r event #wait for pkexec password to be entered
                do

                    if [[ -f "${tmpdir}/writer/ready_indicator" ]] || [[ -f "${tmpdir}/writer/cancelled_indicator" ]]
                    then

                        kill "$(cat "$tmpdir"/writer/inotifywait_pid)"

                        break

                    fi

                done

                if [[ -f "${tmpdir}/writer/ready_indicator" ]]
                then

                    { inotifywait -m -e modify "$tmpdir"/writer/output.txt & echo $! | tee "$tmpdir"/writer/inotifywait_pid; } | while read -r event
                    do

                        line="$(cat "$tmpdir"/writer/output.txt | tail -n 1)"

                        echo "$line"

                        if [[ "$line" == "Script done on "* ]]
                        then

                            kill "$(cat "$tmpdir"/writer/inotifywait_pid)"

                            break

                        fi

                    done | yad --window-icon=shock-os-imager --title="Shock OS Imager" --text="The device $device is being flashed. Please do not unplug the device during this process." --progress --button="Cancel"\!gtk-cancel & yad_pid=$!

                    wait -n "$image_writer_pid" "$yad_pid"

                    if ps -p "$image_writer_pid"
                    then

                        touch "$tmpdir"/writer/kill_indicator

                    else

                        kill "$yad_pid"

                    fi

                    wait "$image_writer_pid"

                    image_writer_ex="$(cat "$tmpdir"/writer/image_writer_ex)"

                    echo "IMAGE_WRITER_EX: $image_writer_ex" #DEBUG

                    if [[ "$image_writer_ex" == "0" ]] #sends out success/fail notification
                    then

                        notify-send --app-name="Shock OS Imager" --icon=shock-os-imager "Device Flashed Successfully!" "The device ($device) was successfully flashed. Feel free to remove it."

                        yad --window-icon=shock-os-imager --image=emblem-default-symbolic --title="Shock OS Imager" --text="The device ($device) was successfully flashed. Feel free to remove it." --button="Dismiss"\!gtk-close

                    else

                        notify-send --app-name="Shock OS Imager" --icon=emblem-important-symbolic "Failed to Flash Device" "Failed to flash the device ($device). Please try again later."

                    fi

                    if [[ "$image_writer_ex" == "2" ]] #If failed to achieve root
                    then

                        yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: Failed to achieve root access." --button="Dismiss"\!gtk-close

                    elif [[ "$image_writer_ex" == "3" ]] #If failed to download something
                    then

                        yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: Failed to download the required files. Please check your internet connection and try again later." --button="Dismiss"\!gtk-close

                    elif [[ "$image_writer_ex" == "4" ]] #If metainfo could not be verified
                    then

                        yad --window-icon=shock-os-imager --title="Shock OS Imager" --image=emblem-important-symbolic --text="ERROR: Metainfo could not be verified. Please try again later." --button="Dismiss"\!gtk-close

                        cleanup

                        exit 1

                    elif [[ "$image_writer_ex" == "5" ]] #If image was corruped
                    then

                        if [[ -f /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" ]]
                        then

                            yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: The image has been corrupted. Would you like to delete it?" --button="Yes, remove"\!gtk-ok --button="No, keep"\!gtk-cancel

                            ex=$?

                            if [[ "$ex" == "0" ]]
                            then

                                pkexec rm -rf /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz"

                            fi

                        else

                            yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: The image has been corrupted." --button="Dismiss"\!gtk-close

                        fi

                    elif [[ "$image_writer_ex" == "6" ]] #If flashing error occured
                    then

                        yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="ERROR: An error occured while flashing the device." --button="Dismiss"\!gtk-close

                    fi  

                else

                    yad --window-icon=shock-os-imager --image=emblem-default-symbolic --title="Shock OS Imager" --text="Operation aborted. No changes were made to device ${device}." --button="Dismiss"\!gtk-close

                fi

                cleanup

            else

                yad --window-icon=shock-os-imager --image=emblem-default-symbolic --title="Shock OS Imager" --text="Operation aborted. No changes were made to device ${device}." --button="Dismiss"\!gtk-close

            fi

        fi

    elif [[ "$ex" == "1" ]] #Refresh
    then

        refresh

    elif [[ "$ex" == "2" ]] #Options
    then

        if [[ -f /usr/share/shock-os-imager/settings.ini ]]
        then

            source /usr/share/shock-os-imager/settings.ini

        else

            caching_enabled="TRUE"

        fi

        output="$(yad --width=300 --window-icon=shock-os-imager --title="Options" --form \
                    --field="<big><b>Caching Images</b></big>":LBL '' \
                    --field="Caching images significantly reduces the amount of time it takes to flash the same image later, but these images also occupy several gigabytes of space. If you flash the same image or images often, and have sufficient space on your computer, caching is recommended. If you rarely use Shock OS Imager and/or don't have enough space on your computer, then we'd recommend disabling caching.":LBL '' \
                    --field="Delete Cached Images":FBTN 'shock-os-imager-remove-cached-images' \
                    --field="Cache Images":CHK "$caching_enabled" \
                    --buttons-layout=edge \
                    --button="Cancel"\!gtk-cancel:1 --button="Apply"\!gtk-ok:0)"

        ex=$?

        caching_enabled_2="$(echo "$output" | awk -F'|' '{print $4}')"

        if [[ "$ex" == "0" ]]
        then

            if [[ "$caching_enabled" != "$caching_enabled_2" ]]
            then

                pkexec bash -c "echo 'caching_enabled=$caching_enabled_2' | tee /usr/share/shock-os-imager/settings.ini"

            fi

        fi

    else

        cleanup

        exit

    fi

done

    

        

















#!/bin/bash





rm ~/.cache/shock-tmp/shock-os-imager/*

until [[ -f ~/.cache/shock-tmp/shock-os-imager/metainfo ]]
do

    wget --timeout 5 https://raw.githubusercontent.com/Shock-OS/Shock-OS/imager/metainfo -P ~/.cache/shock-tmp/shock-os-imager/

    if [[ ! -f ~/.cache/shock-tmp/shock-os-imager/metainfo ]]
    then

        yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="Shock OS Imager requires an internet connection to continue. Please ensure internet connectivity and try again." --buttons-layout=edge --button="Close"\!gtk-close:1 --button="Retry"\!edit-undo:0

        ex=$?

        if [[ "$ex" != "0" ]]
        then

            exit

        fi

    fi

done

function refresh() {

source ~/.cache/shock-tmp/shock-os-imager/metainfo

version=''

edition=''

arch=''

device=''

}

refresh

while true
do

    drives=($(lsblk | grep /media | grep -oP "(sd[a-z]|mmcblk[0-9])" | awk '{print "/dev/"$1}' | sort -u))

    drives_selection=""

    for drive in "${drives[@]}"
    do

        drive_label=""

        for num in {1..1000}
        do

            part_label=""

            if [[ "$drive" == "/dev/mmcblk"* ]]
            then

                part_label="$(lsblk --output LABEL "${drive}p${num}")"

            else

                part_label="$(lsblk --output LABEL "${drive}${num}")"

            fi

            part_label="${part_label:6}" #Removes leading 'LABEL ' from part_label

            if [[ -z "$part_label" ]]
            then

                break

            elif [[ -z "$drive_label" ]]
            then

                drive_label="$part_label"

            else

                drive_label+=", $part_label"

            fi

        done

        if [[ -z "$drive_label" ]]
        then

            drive_label="NO LABEL"

        fi

        if [[ "$device" == "$drive" ]]
        then

            drive="^${drive}"

        fi

        if [[ -z "$drives_selection" ]]
        then

            drives_selection="$drive ($drive_label)"

        else

            drives_selection+='!'"$drive ($drive_label)"

        fi

    done

    versions_yad_cb=""

    for item in "${versions[@]}"
    do

        if [[ "$version" == "$item" ]]
        then

            item="^${item}"

        fi

        if [[ -z "$versions_yad_cb" ]]
        then

            versions_yad_cb+="$item"

        else

            versions_yad_cb+="!${item}"

        fi

    done

    if [[ "$edition" == "MATE" ]]
    then

        editions_yad_cb='GNOME!^MATE'

    else

        editions_yad_cb='GNOME!MATE'

    fi

    if [[ "$arch" == "32-bit" ]]
    then

        arches_yad_cb='64-bit!^32-bit'

    else

        arches_yad_cb='64-bit!32-bit'

    fi

    output="$(yad --width=500 --height=280 --window-icon=shock-os-imager --title="Shock OS Imager" --form --always-print-result --field="Version:":LBL '' --field="":CB "$versions_yad_cb" --field="Edition:":LBL '' --field="":CB "$editions_yad_cb" --field="Architecture:":LBL '' --field="":CB "$arches_yad_cb" --field="Storage Device:":LBL '' --field="":CB "$drives_selection" --buttons-layout=spread --button="Options"\!tweaks-app:2 --button="Refresh"\!gtk-refresh:1 --button="Start Flashing"\!gtk-ok:0)"

    ex=$?

    version="$(echo "$output" | awk -F'|' '{print $2}')"

    edition="$(echo "$output" | awk -F'|' '{print $4}')"

    arch="$(echo "$output" | awk -F'|' '{print $6}')"

    device="$(echo "$output" | awk -F'|' '{print $8}')"

    device="${device%% *}"

    if [[ "$ex" == "0" ]] #Flash
    then

        yad --window-icon=shock-os-imager --image=emblem-important-symbolic --title="Shock OS Imager" --text="WARNING: This will ERASE ALL DATA on device ${device}. Are you sure you would like to continue?" --button="No, cancel"\!gtk-cancel:1 --button="Yes, continue"\!go-next:0

        ex=$?

        if [[ "$ex" == "0" ]]
        then

            image_writer_output_dir="$(mktemp -d)"

            { script -afe "$image_writer_output_dir"/output.txt -c "pkexec shock-os-imager-write-image \"$version\" \"$edition\" \"$arch\" \"$device\" \"$image_writer_output_dir\"" || touch "$image_writer_output_dir"/cancelled_indicator; image_writer_ex=$?; } & image_writer_pid=$!

            { inotifywait -m -e create "$image_writer_output_dir" & echo $! | tee "$image_writer_output_dir"/inotifywait_pid; } | while read -r event #wait for pkexec password to be entered
            do

                if [[ -f "${image_writer_output_dir}/ready_indicator" ]] || [[ -f "${image_writer_output_dir}/cancelled_indicator" ]]
                then

                    kill "$(cat "$image_writer_output_dir"/inotifywait_pid)"

                    break

                fi

            done

            if [[ -f "${image_writer_output_dir}/ready_indicator" ]]
            then

                { inotifywait -m -e modify "$image_writer_output_dir"/output.txt & echo $! | tee "$image_writer_output_dir"/inotifywait_pid; } | while read -r event
                do

                    line="$(cat "$image_writer_output_dir"/output.txt | tail -n 1)"

                    echo "$line"

                    if [[ "$line" == "Script done on "* ]]
                    then

                        kill "$(cat "$image_writer_output_dir"/inotifywait_pid)"

                        break

                    fi

                done | yad --window-icon=shock-os-imager --title="Shock OS Imager" --text="The device $device is being flashed. Please do not unplug the device during this process." --progress --button="Cancel"\!gtk-cancel & yad_pid=$!

                wait -n "$image_writer_pid" "$yad_pid"

                if ps -p "$image_writer_pid"
                then

                    touch "$image_writer_output_dir"/kill_indicator

                else

                    kill "$yad_pid"

                fi

                echo "IMAGE_WRITER_EX: $image_writer_ex" #DEBUG

                if [[ "$image_writer_ex" == "0" ]]
                then

                    notify-send --app-name="Shock OS Imager" --icon=shock-os-imager "Device Flashed Successfully!" "The device ($device) was successfully flashed. Feel free to remove it."

                else

                    notify-send --app-name="Shock OS Imager" --icon=emblem-important-symbolic "Failed to Flash Device" "Failed to flash the device ($device). Please try again later."

                fi

            else

                yad --window-icon=shock-os-imager --image=emblem-default-symbolic --title="Shock OS Imager" --text="Operation aborted. No changes were made to device ${device}." --button="Dismiss"\!gtk-close

            fi

        else

            yad --window-icon=shock-os-imager --image=emblem-default-symbolic --title="Shock OS Imager" --text="Operation aborted. No changes were made to device ${device}." --button="Dismiss"\!gtk-close

        fi

    elif [[ "$ex" == "1" ]] #Refresh
    then

        refresh

    elif [[ "$ex" == "2" ]] #Options
    then

        if [[ -f /usr/share/shock-os-imager/settings.ini ]]
        then

            source /usr/share/shock-os-imager/settings.ini

        else

            caching_enabled="TRUE"

            device_verification_enabled="FALSE"

        fi

        output="$(yad --width=300 --window-icon=shock-os-imager --title="Options" --form \
                    --field="<big><b>Caching Images</b></big>":LBL '' \
                    --field="Caching images significantly reduces the amount of time it takes to flash the same image later, but these images also occupy several gigabytes of space. If you flash the same image or images often, and have sufficient space on your computer, caching is recommended. If you rarely use Shock OS Imager and/or don't have enough space on your computer, then we'd recommend disabling caching.":LBL '' \
                    --field="Delete Cached Images":FBTN 'shock-os-imager-remove-cached-images' \
                    --field="Cache Images":CHK "$caching_enabled" \
                    --field="":LBL '' \
                    --field="<big><b>Device Verification</b></big>":LBL '' \
                    --field="If enabled, the device will be checked after flashing to ensure there were no errors in the process, and that the device contains the correct contents. This option is disabled by default because it takes a long time and errors are unlikely.":LBL '' \
                    --field="Verify device after flashing":CHK "$device_verification_enabled" --buttons-layout=edge --button="Cancel"\!gtk-cancel:1 --button="Apply"\!gtk-ok:0)"

        ex=$?

        caching_enabled_2="$(echo "$output" | awk -F'|' '{print $4}')"

        device_verification_enabled_2="$(echo "$output" | awk -F'|' '{print $8}')"

        if [[ "$ex" == "0" ]]
        then

            if [[ "$caching_enabled" != "$caching_enabled_2" ]] || [[ "$device_verification_enabled" != "$device_verification_enabled_2" ]]
            then

                pkexec bash -c "echo 'caching_enabled=$caching_enabled_2
device_verification_enabled=$device_verification_enabled_2' | tee /usr/share/shock-os-imager/settings.ini"

            fi

        fi

    else

        exit

    fi

done

    

        

















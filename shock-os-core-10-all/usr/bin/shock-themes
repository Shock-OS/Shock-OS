#!/bin/bash

IFS=$'\n'

runuser="$(whoami)"

nl="${#runuser}"

nl=$((nl+1))

mkdir -p ~/.config/shock/themes

yaru_colors=(Bark Blue Magenta Olive Orange PrussianGreen Purple Red Sage Viridian)

#BEGIN PRELOADING OF `FIND` COMMAND ARGUMENTS USED WHEN INSTALLING THEMES

archive_types=($(unp -s | awk 'NR>1 {print $1}' | cut -d':' -f1 | tr ',' '\n' | sed 's/^/./' | awk '{ print length, $0 }' | sort -nr | cut -d" " -f2))

find_cmd_args_archives=""

for archive_type in "${archive_types[@]}"
do

    if [[ -z "$find_cmd_args_archives" ]]
    then

        find_cmd_args_archives="-name '*${archive_type}'"

    else

        find_cmd_args_archives+=" -o -name '*${archive_type}'"

    fi

done

source /usr/share/shock/dist-info

targets=(index.theme gtk-3.0 gtk-4.0 cursors cursor.theme)

if [[ "$DE_EDITION" == "GNOME" ]]
then

    targets+=(gnome-shell)

else #MATE

    targets+=(metacity-1)

fi

find_cmd_args_targets=""

for target in "${targets[@]}"
do

    if [[ -z "$find_cmd_args_targets" ]]
    then

        find_cmd_args_targets="-name '*${target}'"

    else

        find_cmd_args_targets+=" -o -name '*${target}'"

    fi

done

#END PRELOADING OF `FIND` COMMAND ARGUMENTS USED WHEN INSTALLING THEMES

function yad() {

GDK_BACKEND=x11 /usr/bin/yad "$@"

}

function get_gtk_theme() {

if [[ "$DE_EDITION" == "GNOME" ]]
then

    gsettings get org.gnome.desktop.interface gtk-theme | sed "s/^'//;s/'$//"

else #MATE

    gsettings get org.mate.interface gtk-theme | sed "s/^'//;s/'$//"

fi

}

function get_libadwaita_theme() {

local theme="$(readlink ~/.config/gtk-4.0)"

local theme="$(dirname "$theme")"

echo "$theme"

}

function get_icon_theme() {

if [[ "$DE_EDITION" == "GNOME" ]]
then

    gsettings get org.gnome.desktop.interface icon-theme | sed "s/^'//;s/'$//"

else #MATE

    gsettings get org.mate.interface icon-theme | sed "s/^'//;s/'$//"

fi

}

function get_cursor_theme() {

if [[ "$DE_EDITION" == "GNOME" ]]
then

    gsettings get org.gnome.desktop.interface cursor-theme | sed "s/^'//;s/'$//"

else #MATE

    gsettings get org.mate.peripherals-mouse cursor-theme | sed "s/^'//;s/'$//"

fi

}

function set_gtk_theme() {

if [[ "$DE_EDITION" == "GNOME" ]]
then

    gsettings set org.gnome.desktop.interface gtk-theme "$1"

else #MATE

    gsettings set org.mate.interface gtk-theme "$1"

fi

}

function set_libadwaita_theme() {

rm -r ~/.config/gtk-4.0

ln -sf /usr/share/themes/"$1"/gtk-4.0 ~/.config

}

function set_icon_theme() {

if [[ "$DE_EDITION" == "GNOME" ]]
then

    gsettings set org.gnome.desktop.interface icon-theme "$1"

else #MATE

    gsettings set org.mate.interface icon-theme "$1"

fi

}

function set_cursor_theme() {

if [[ "$DE_EDITION" == "GNOME" ]]
then

    gsettings set org.gnome.desktop.interface cursor-theme "$1"

else #MATE

    gsettings set org.mate.peripherals-mouse cursor-theme "$1"

fi

}

function unsupported_message() {

yad --window-icon=preferences-desktop-theme --title="Themes" --image=emblem-important-symbolic --text="Sorry, '$file' does not contain a supported theme." --button="Dismiss"\!gtk-close

}

function install_window() {

local files=($(yad --window-icon=preferences-desktop-theme --title="Themes" --file --multiple --separator=$'\n' --button="Install"\!document-open))

local tmpdir="$(mktemp -d)"

target_dirs=()

for file in "${files[@]}"
do

    if [[ "$(shock-shared-function-is-compressed "$file")" == "TRUE" ]]
    then

        for type in "${archive_types[@]}"
        do

            if [[ "$file" == *"$type" ]]
            then

                file_newname="$(basename "$file")"

                file_newname="${file_newname::-${#type}}"

                break

            fi

        done

        mkdir -p "${tmpdir}/${file_newname}"

        cp "$file" "$tmpdir"

        cd "$tmpdir"

        unp "$(basename "$file")"

        file="${tmpdir}/${file_newname}"

    fi

    for archive in $(eval "find $file $find_cmd_args_archives")
    do

        cd "$(dirname "$archive")"

        unp "$(basename "$archive")"

    done

    for target in $(eval "find $file $find_cmd_args_targets")
    do

        target="$(dirname "$target")"

        if [[ ! " ${target_dirs[@]} " =~ " $target " ]]
        then

            target_dirs+=("$target")

        fi

    done

done

for target in "${target_dirs[@]}"
do

    install_theme "$target"

done | /usr/bin/yad --fixed --window-icon=preferences-desktop-theme --title="Themes" --text="Installing..." --center --progress --pulsate --auto-close --undecorated --no-buttons --skip-taskbar

rm -r "$tmpdir"

sudo shock-themes-sync

}

function install_theme() {

local dir="$1"

echo "#Installing $(basename "$dir")..."

if [[ "$(cat "${dir}/index.theme")" =~ "[Icon Theme]" ]] || [[ -f "${dir}/icon-theme.cache" ]] || [[ -d "${dir}/cursors" ]] || [[ -f "${dir}/cursor.theme" ]]
then

    shock-shared-function-replace-start-icons "$dir"

    mkdir -p ~/.shock/icons/

    cp -r "$dir" ~/.shock/icons/

fi

if [[ -d "${dir}/gtk-3.0" ]] || [[ -d "${dir}/gtk-4.0" ]] || [[ -d "${dir}/gnome-shell" ]] || [[ -d "${dir}/metacity-1" ]]
then

    mkdir -p ~/.shock/themes/

    cp -r "$dir" ~/.shock/themes/

fi

}

function cannot_remove_bc_in_use_message() {

yad --window-icon=preferences-desktop-theme --image=emblem-important-symbolic --title="Themes" --text="You cannot remove this theme while it is in use. Please switch to a different theme before attempting to remove this one." --button="Dismiss"\!gtk-close

}

function manage_window() {

themes=()

for folder in {themes,icons}
do

    for theme in ~/."$folder"/*
    do

        theme=$(basename "$theme")

        theme="${theme:$nl}"

        themes+=("$theme")

    done

done

themes=($(printf "%s\n" "${themes[@]}" | sort -u))

output="$(yad --window-icon=preferences-desktop-theme --title="Themes" --text="Rename, modify, or remove themes." --height=500 --list --always-print-result \
                --column="Name":TEXT \
                --no-headers \
                "${themes[@]}" \
                --button="Remove"\!remove:1 --button="Rename"\!gtk-edit:2 --button="Done"\!gtk-ok:0)"

ex=$?

theme=$(echo "$output" | awk -F'|' '{print $1}')

if [[ "$ex" == "1" ]] #Remove
then

    if [[ -d ~/.themes/"${runuser}_${theme}" ]] #If theme
    then

        if [[ "$DE_EDITION" == "GNOME" ]] && [[ -d ~/.themes/"${runuser}_${theme}"/gnome-shell ]] && [[ "$(gsettings get org.gnome.shell.extensions.user-theme name | sed "s/^'//;s/'$//")" == "${runuser}_${theme}" ]]
        then

            cannot_remove_bc_in_use_message

        elif [[ -d ~/.themes/"${runuser}_${theme}"/gtk-3.0 ]] && [[ "$(get_gtk_theme)" == "${runuser}_${theme}" ]]
        then

            cannot_remove_bc_in_use_message

        elif [[ "$DE_EDITION" == "MATE" ]] && [[ -d ~/.themes/"${runuser}_${theme}"/metacity-1 ]] && [[ "$(gsettings get org.mate.Marco.general theme | sed "s/^'//;s/'$//")" == "${runuser}_${theme}" ]]
        then

            cannot_remove_bc_in_use_message

        elif [[ -d ~/.themes/"${runuser}_${theme}"/gtk-4.0 ]] && [[ "$(get_libadwaita_theme)" == "${runuser}_${theme}" ]]
        then

            cannot_remove_bc_in_use_message

        elif [[ -d ~/.icons/"${runuser}_${theme}" ]] && [[ "$(get_icon_theme)" == "${runuser}_${theme}" || "$(get_cursor_theme)" == "${runuser}_${theme}" ]]
        then

            cannot_remove_bc_in_use_message

        else

            yad --window-icon=preferences-desktop-theme --title="Themes" --text="Are you sure you would like to remove '${theme}'?" --button="Yes, remove"\!remove:1 --button="No, cancel"\!gtk-cancel:0

            ex=$?

            if [[ "$ex" == "1" ]]
            then

                rm -r ~/.themes/"${runuser}_${theme}"

            fi

        fi

    else #If icon theme

        if [[ "$(get_icon_theme)" == "${runuser}_${theme}" ]] || [[ "$(get_cursor_theme)" == "${runuser}_${theme}" ]]
        then

            cannot_remove_bc_in_use_message

        else

            yad --window-icon=preferences-desktop-theme --title="Themes" --text="Are you sure you would like to remove '${theme}'?" --button="Yes, remove"\!remove:1 --button="No, cancel"\!gtk-cancel:0

            ex=$?

            if [[ "$ex" == "1" ]]
            then

                rm -r /.icons/"${runuser}_${theme}"

            fi

        fi

    fi

elif [[ "$ex" == "2" ]] #Rename
then

    success="FALSE"

    until [[ "$success" == "TRUE" ]]
    do

        newname="$(yad --window-icon=preferences-desktop-theme --title="Themes" --text="New name for theme:" --entry \
                        --entry-text="$theme" \
                        --button="Cancel"\!gtk-cancel:1 --button="Rename"\!gtk-edit:0)"

        ex=$?

        if [[ "$ex" == "0" ]]
        then

            if [[ -z "$newname" ]]
            then

                yad --window-icon=preferences-desktop-theme --image=emblem-important-symbolic --title="Themes" --text="The name cannot be empty. Please try again." --button="Retry"\!edit-undo

            elif [[ -d ~/.themes/"${runuser}_${newname}" ]] || [[ -d ~/.icons/"${runuser}_${newname}" ]]
            then

                yad --window-icon=preferences-desktop-theme --image=emblem-important-symbolic --title="Themes" --text="There is already a theme named '${newname}'. Please choose a different name." --button="Retry"\!edit-undo

            else

                success="TRUE"

                if [[ -d ~/.themes/"${runuser}_${theme}" ]]
                then

                    mv ~/.themes/"${runuser}_${theme}" ~/.themes/"${runuser}_${newname}"

                    if [[ "$DE_EDITION" == "GNOME" ]]
                    then

                        if [[ "$(gsettings get org.gnome.shell.extensions.user-theme name)" == "'${runuser}_${theme}'" ]]
                        then

                            gsettings set org.gnome.shell.extensions.user-theme name "${runuser}_${newname}"

                        fi

                    else #MATE

                        if [[ "$(gsettings get org.mate.Marco.general theme)" == "'${runuser}_${theme}'" ]]
                        then

                            gsettings set org.mate.Marco.general theme "${runuser}_${newname}"

                        fi

                    fi

                    if [[ "$(get_gtk_theme)" == "${runuser}_${theme}" ]]
                    then

                        set_gtk_theme "${runuser}_${newname}"

                    fi

                    if [[ "$(get_libadwaita_theme)" == "${runuser}_${theme}" ]]
                    then

                        set_libadwaita_theme "${runuser}_${newname}"

                    fi

                else #if icon theme

                    mv ~/.icons/"${runuser}_${theme}" ~/.icons/"${runuser}_${newname}"

                    if [[ "$(get_icon_theme)" == "${runuser}_${theme}" ]]
                    then

                        set_icon_theme "${runuser}_${newname}"

                    fi

                    if [[ "$(get_cursor_theme)" == "${runuser}_${theme}" ]]
                    then

                        set_cursor_theme "${runuser}_${newname}"

                    fi

                fi

            fi

        else

            success="TRUE"

        fi

    done

fi

}

while true
do

    source ~/.config/shock/themes/yaru

    if [[ "$DE_EDITION" == "GNOME" ]]
    then

        color_scheme="$(gsettings get org.gnome.desktop.interface color-scheme)"

        if [[ "$color_scheme" == "'prefer-dark'" ]]
        then

            lod='Light!^Dark'

        else

            lod='Light!Dark'

        fi

    else #MATE

        if [[ "$user_lod" == "dark" ]]
        then

            lod='Light!^Dark'

        else

            lod='Light!Dark'

        fi

    fi

    color=""

    yad_cb_colors=""

    for theme in "${yaru_colors[@]}"
    do

        if [[ "$user_color" == "$(echo "$theme" | awk '{print tolower($0)}')" ]] || [[ "$theme" == "Orange" && "$user_color" == "orange" ]]
        then

            theme="^${theme}"

        fi

        if [[ -z "$yad_cb_colors" ]]
        then

            yad_cb_colors="$theme"

        else

            yad_cb_colors+="!${theme}"

        fi

    done

    output="$(yad --window-icon=preferences-desktop-theme --title="Themes" --form \
                    --field="Style:":CB "$lod" \
                    --field="Color:":CB "$yad_cb_colors" \
                    --button="Use Custom Themes"\!tweaks-app:1 --button="Apply"\!gtk-ok:0)"

    ex=$?

    lod=$(echo "$output" | awk -F'|' '{print $1}')

    color=$(echo "$output" | awk -F'|' '{print $2}')

    lod=$(echo "$lod" | awk '{print tolower($0)}')

    color=$(echo "$color" | awk '{print tolower($0)}')

    if [[ "$ex" == "0" ]] #Apply
    then

        if [[ "$color" == "orange" ]]
        then

            if [[ "$lod" == "dark" ]]
            then

                theme="Yaru-dark"

            else

                theme="Yaru"

            fi

        elif [[ "$lod" == "dark" ]]
        then

            theme="Yaru-${color}-dark"

        else

            theme="Yaru-${color}"

        fi

        if [[ "$DE_EDITION" == "GNOME" ]]
        then

            gsettings set org.gnome.shell.extensions.user-theme name "$theme"

            if [[ "$lod" == "dark" ]]
            then

                gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"

            else

                gsettings set org.gnome.desktop.interface color-scheme "prefer-light"

            fi

        else #MATE

            if [[ "$lod" == "dark" ]]
            then

                gsettings set org.mate.Marco.general theme "Yaru-dark"

            else

                gsettings set org.mate.Marco.general theme "Yaru"

            fi

        fi

        set_gtk_theme "$theme"

        set_icon_theme "$theme"

        set_libadwaita_theme "$theme"

        set_cursor_theme "Yaru"

        echo "user_lod=${lod}
    user_color=${color}" | tee ~/.config/shock/themes/yaru

    elif [[ "$ex" == "1" ]] #Use custom themes
    then

        source ~/.config/shock/themes/custom

        gnome_shell_themes=""

        gtk_themes=""

        metacity_themes=""

        libadwaita_themes=""

        icon_themes=""

        cursor_themes=""

        for theme in $(ls ~/.themes)
        do

            if [[ "$DE_EDITION" == "GNOME" ]]
            then

                if [[ -d ~/.themes/"$theme"/gnome-shell ]]
                then

                    if [[ -z "$gnome_shell_themes" ]]
                    then

                        gnome_shell_themes="${theme:$nl}"

                    else

                        if [[ "$user_gnome_shell_theme" == "${theme:$nl}" ]]
                        then

                            gnome_shell_themes+="!^${theme:$nl}"

                        else

                            gnome_shell_themes+="!${theme:$nl}"

                        fi

                    fi

                fi

            fi

            if [[ -d ~/.themes/"$theme"/gtk-3.0 ]]
            then

                if [[ -z "$gtk_themes" ]]
                then

                    gtk_themes="${theme:$nl}"

                else

                    if [[ "$user_gtk_theme" == "${theme:$nl}" ]]
                    then

                        gtk_themes+="!^${theme:$nl}"

                    else

                        gtk_themes+="!${theme:$nl}"

                    fi

                fi

            fi

            if [[ "$DE_EDITION" == "MATE" ]]
            then

                if [[ -d ~/.themes/"$theme"/metacity-1 ]]
                then

                    if [[ -z "$metacity_themes" ]]
                    then

                        metacity_themes="${themes:$nl}"

                    else

                        if [[ "$user_metacity_theme" == "${theme:$nl}" ]]
                        then

                            metacity_themes+="!^${theme:$nl}"

                        else

                            metacity_themes+="!${theme:$nl}"

                        fi

                    fi

                fi

            fi

            if [[ -d ~/.themes/"$theme"/gtk-4.0 ]]
            then

                if [[ -z "$libadwaita_themes" ]]
                then

                    libadwaita_themes="${theme:$nl}"

                else

                    if [[ "$user_libadwaita_theme" == "${theme:$nl}" ]]
                    then

                        libadwaita_themes+="!^${theme:$nl}"

                    else

                        libadwaita_themes+="!${theme:$nl}"

                    fi

                fi

            fi

        done

        for theme in $(ls ~/.icons)
        do

            if [[ -f ~/.icons/"$theme"/icon-theme.cache || "$(cat ~/.icons/"$theme"/index.theme)" =~ "[Icon Theme]" ]] && [[ ! -d ~/.icons/"$theme"/cursors ]]
            then

                if [[ -z "$icon_themes" ]]
                then

                    icon_themes="${theme:$nl}"

                else

                    if [[ "$user_icon_theme" == "${theme:$nl}" ]]
                    then

                        icon_themes+="!^${theme:$nl}"

                    else

                        icon_themes+="!${theme:$nl}"

                    fi

                fi

            fi

            if [[ -d ~/.icons/"$theme"/cursors ]] || [[ -f ~/.icons/"$theme"/cursor.theme ]]
            then

                if [[ -z "$cursor_themes" ]]
                then

                    cursor_themes="${theme:$nl}"

                else

                    if [[ "$user_cursor_theme" == "${theme:$nl}" ]]
                    then

                        cursor_themes+="!^${theme:$nl}"

                    else

                        cursor_themes+="!${theme:$nl}"

                    fi

                fi

            fi

        done

        if [[ -n "$gnome_shell_themes" ]]
        then

            if [[ "$user_gnome_shell_theme" == "(Leave unchanged)" ]]
            then

                gnome_shell_themes+="!^(Leave unchanged)"

            else

                gnome_shell_themes+="!(Leave unchanged)"

            fi

        fi

        if [[ -n "$gtk_themes" ]]
        then

            if [[ "$user_gtk_theme" == "(Leave unchanged)" ]]
            then

                gtk_themes+="!^(Leave unchanged)"

            else

                gtk_themes+="!(Leave unchanged)"

            fi

        fi

        if [[ -n "$metacity_themes" ]]
        then

            if [[ "$user_metacity_theme" == "(Leave unchanged)" ]]
            then

                metacity_themes+="!^(Leave unchanged)"

            else

                metacity_themes+="!(Leave unchanged)"

            fi

        fi

        if [[ -n "$libadwaita_themes" ]]
        then

            if [[ "$user_libadwaita_theme" == "(Leave unchanged)" ]]
            then

                libadwaita_themes+="!^(Leave unchanged)"

            else

                libadwaita_themes+="!(Leave unchanged)"

            fi

        fi

        if [[ -n "$icon_themes" ]]
        then

            if [[ "$user_icon_theme" == "(Leave unchanged)" ]]
            then

                icon_themes+="!^(Leave unchanged)"

            else

                icon_themes+="!(Leave unchanged)"

            fi

        fi

        if [[ -n "$cursor_themes" ]]
        then

            if [[ "$user_cursor_theme" == "(Leave unchanged)" ]]
            then

                cursor_themes+="!^(Leave unchanged)"

            else

                cursor_themes+="!(Leave unchanged)"

            fi

        fi

        if [[ "$DE_EDITION" == "GNOME" ]]
        then

            output="$(yad --window-icon=preferences-desktop-theme --title="Themes" --form \
                            --field="Gnome Shell Theme:":LBL '' \
                            --field="":CB "$gnome_shell_themes" \
                            --field="GTK Theme:":LBL '' \
                            --field="":CB "$gtk_themes" \
                            --field="Libadwaita Theme:":LBL '' \
                            --field="":CB "$libadwaita_themes" \
                            --field="Icon Theme:":LBL '' \
                            --field="":CB "$icon_themes" \
                            --field="Cursor Theme":LBL '' \
                            --field="":CB "$cursor_themes" \
                            --field="Change cursor size":BTN 'shock-themes-change-cursor-size' \
                            --buttons-layout=spread \
                            --button="Install"\!add:1 --button="Manage"\!preferences-system:2 --button="Apply"\!gtk-ok:0)"

            ex=$?

            gnome_shell_theme=$(echo "$output" | awk -F'|' '{print $2}')

            gtk_theme=$(echo "$output" | awk -F'|' '{print $4}')

            libadwaita_theme=$(echo "$output" | awk -F'|' '{print $6}')

            icon_theme=$(echo "$output" | awk -F'|' '{print $8}')

            cursor_theme=$(echo "$output" | awk -F'|' '{print $10}')

            if [[ "$ex" == "0" ]] #Apply
            then

                if [[ "$gnome_shell_theme" != "(Leave unchanged)" ]] && [[ "$gnome_shell_theme" != "(null)" ]]
                then

                    gsettings set org.gnome.shell.extensions.user-theme name "${runuser}_${gnome_shell_theme}"

                fi

                if [[ "$gtk_theme" != "(Leave unchanged)" ]] && [[ "$gtk_theme" != "(null)" ]]
                then

                    set_gtk_theme "${runuser}_${gtk_theme}"

                fi

                if [[ "$libadwaita_theme" != "(Leave unchanged)" ]] && [[ "$libadwaita_theme" != "(null)" ]]
                then

                    set_libadwaita_theme "${runuser}_${libadwaita_theme}"

                fi

                if [[ "$icon_theme" != "(Leave unchanged)" ]] && [[ "$icon_theme" != "(null)" ]]
                then

                    set_icon_theme "${runuser}_${icon_theme}"

                fi

                if [[ "$cursor_theme" != "(Leave unchanged)" ]] && [[ "$cursor_theme" != "(null)" ]]
                then

                    set_cursor_theme "${runuser}_${cursor_theme}"

                fi

                echo "user_gnome_shell_theme=\"$gnome_shell_theme\"
    user_gtk_theme=\"$gtk_theme\"
    user_libadwaita_theme=\"$libadwaita_theme\"
    user_icon_theme=\"$icon_theme\"
    user_cursor_theme=\"$cursor_theme\"" | tee ~/.config/shock/themes/custom

            elif [[ "$ex" == "1" ]] #Install
            then

                install_window

            elif [[ "$ex" == "2" ]] #Manage
            then

                manage_window

            fi

        else #MATE

            output="$(yad --window-icon=preferences-desktop-theme --title="Themes" --form \
                            --field="GTK Theme:":LBL '' \
                            --field="":CB "$gtk_themes" \
                            --field="Metacity Theme:":LBL '' \
                            --field="":CB "$metacity_themes" \
                            --field="Libadwaita Theme:":LBL '' \
                            --field="":CB "$libadwaita_themes" \
                            --field="Icon Theme:":LBL '' \
                            --field="":CB "$icon_themes" \
                            --field="Cursor Theme":LBL '' \
                            --field="":CB "$cursor_themes" \
                            --field="Change cursor size":BTN 'shock-themes-change-cursor-size' \
                            --buttons-layout=spread \
                            --button="Install"\!add:1 --button="Manage"\!preferences-system:2 --button="Apply"\!gtk-ok:0)"

            ex=$?

            gtk_theme=$(echo "$output" | awk -F'|' '{print $2}')

            metacity_theme=$(echo "$output" | awk -F'|' '{print $4}')

            libadwaita_theme=$(echo "$output" | awk -F'|' '{print $6}')

            icon_theme=$(echo "$output" | awk -F'|' '{print $8}')

            cursor_theme=$(echo "$output" | awk -F'|' '{print $10}')

            if [[ "$ex" == "0" ]]
            then

                if [[ "$gtk_theme" != "(Leave unchanged)" ]] && [[ "$gtk_theme" != "(null)" ]]
                then

                    set_gtk_theme "${runuser}_${gtk_theme}"

                fi

                if [[ "$metacity_theme" != "(Leave unchanged)" ]] && [[ "$metacity_theme" != "(null)" ]]
                then

                    gsettings set org.mate.Marco.general theme "${runuser}_${metacity_theme}"

                fi

                if [[ "$libadwaita_theme" != "(Leave unchanged)" ]] && [[ "$libadwaita_theme" != "(null)" ]]
                then

                    set_libadwaita_theme "${runuser}_${libadwaita_theme}"

                fi

                if [[ "$icon_theme" != "(Leave unchanged)" ]] && [[ "$icon_theme" != "(null)" ]]
                then

                    set_icon_theme "${runuser}_${icon_theme}"

                fi

                if [[ "$cursor_theme" != "(Leave unchanged)" ]] && [[ "$cursor_theme" != "(null)" ]]
                then

                    set_cursor_theme "${runuser}_${cursor_theme}"

                fi

                echo "user_gtk_theme=\"$gtk_theme\"
    user_metacity_theme=\"$metacity_theme\"
    user_libadwaita_theme=\"$libadwaita_theme\"
    user_icon_theme=\"$icon_theme\"
    user_cursor_theme=\"$cursor_theme\"" | tee ~/.config/shock/themes/custom

            elif [[ "$ex" == "1" ]] #Install
            then

                install_window

            elif [[ "$ex" == "2" ]] #Manage
            then

                manage_window

            fi

        fi

        echo "GTK THEME: $gtk_theme
    METACITY THEME: $metacity_theme
    LIBADWAITA THEME: $libadwaita_theme
    ICON THEME: $icon_theme
    CURSOR THEME: $cursor_theme" #DEBUG

    else

        exit

    fi

done



















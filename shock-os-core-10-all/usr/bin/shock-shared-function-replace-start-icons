#!/bin/bash

dir="$1"

for icon in /usr/share/shock-themes/icons/symbolic/16x16/*
do

    for target in $(find "$dir" -name "$(basename "$icon")")
    do

        if [[ -n "$target" ]]
        then

            cp -f "/usr/share/shock-themes/icons/symbolic/$(identify -format "%wx%h" "$target")/$(basename "$icon")" "$target"

        fi

    done

done

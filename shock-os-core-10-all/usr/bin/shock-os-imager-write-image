#!/bin/bash

#the root check element begins

if (($(id -u)!=0))
then

    echo "Script must be run as root. Exiting..."

    exit

fi

#the root check element ends

version="$1"

edition="$2"

arch="$3"

arch="${arch//-/_}"

device="$4"

image_writer_output_dir="$5"

if [[ ! -f /usr/share/shock-os-imager/settings.ini ]]
then

    echo 'caching_enabled=TRUE
device_verification_enabled=TRUE' | tee /usr/share/shock-os-imager/settings.ini

fi

source /usr/share/shock-os-imager/settings.ini

touch "$image_writer_output_dir"/ready_indicator

{ inotifywait -m "$image_writer_output_dir" & inotifywait_killpid=$!; } | while read -r event
do

    if [[ -f "${image_writer_output_dir}/kill_indicator" ]]
    then

        echo "CANCELLING..."

        kill $$

    elif [[ ! -f "${image_writer_output_dir}/output.txt" ]]
    then

        kill "$inotifywait_killpid"

    fi

done &

mkdir -p /usr/share/shock-os-imager/cache/images

mkdir -p /usr/share/shock-os-imager/cache/sigs

rm /usr/share/shock-os-imager/metainfo

rm -rf /usr/share/shock-os-imager/cache/sigs/*

echo "#Getting metadata..."

wget -q https://raw.githubusercontent.com/Shock-OS/Shock-OS/imager/metainfo -P /usr/share/shock-os-imager/

source /usr/share/shock-os-imager/metainfo

imagevar="${version}_${edition}_${arch}"

if [[ ! -f /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" ]]
then

    url="${imagevar}_url"

    url="${!url}"

    wget -O /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" "$url" 2>&1 | sed -u 's/.* \([0-9]\+%\)\ \+\([0-9.]\+.\) \(.*\)/\1\n# Downloading at \2\/s, ETA \3/'

fi

sig_url="${imagevar}_sig_url"

sig_url="${!sig_url}"

echo "#Getting signature..."

wget -q -O /usr/share/shock-os-imager/cache/sigs/"${imagevar}.img.xz.sig" "$sig_url"

echo "#Verifying image..."

rm /usr/share/shock-os-imager/key.asc

wget https://raw.githubusercontent.com/Shock-OS/Shock-OS/imager/key.asc -P /usr/share/shock-os-imager/

gpg --import /usr/share/shock-os-imager/key.asc

gpg --verify /usr/share/shock-os-imager/cache/sigs/"${imagevar}.img.xz.sig" /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" || { echo 'ERROR: IMAGE FILE DID NOT MATCH SIGNATURE!!!'; exit 1; }

imagevar_compressed_sha256sum="${imagevar}_compressed_sha256sum"

compressed_sha256sum="$(sha256sum /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" | cut -d' ' -f1)"

if [[ "$compressed_sha256sum" != "${!imagevar_compressed_sha256sum}" ]]
then

    echo 'ERROR: INVALID sha256SUM, FILE HAS BEEN TAMPERED WITH!!!'

    exit 1

fi

echo "#Writing image..."

umount $device*

image_size=$(xz -l /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" | awk 'NR==2 {print $5}')

image_size=$(echo "$image_size" | sed 's/,//g' | cut -d '.' -f 1)

image_size=$((image_size*1024*1024))

xz -cd /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" | pv -s "$image_size" -n | dd of=$device bs=4M

if [[ "$device_verification_enabled" == "TRUE" ]]
then

    echo "#Verifying..."

    uncompressed_size="$(xz -cd /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz" | wc -c)"

    device_sha256sum="$(dd if="$device" bs=1 count="$uncompressed_size" | pv -s "$uncompressed_size" -n | sha256sum | cut -d' ' -f1)"

    imagevar_uncompressed_sha256sum="${imagevar}_uncompressed_sha256sum"

    if [[ "$device_sha256sum" != "${!imagevar_uncompressed_sha256sum}" ]]
    then

        echo 'ERROR: VERIFICATION FAILED, AN ERROR OCCURRED WHILE FLASHING!!!'

        exit 1

    fi

fi

if [[ "$caching_enabled" == "FALSE" ]]
then

    rm -rf /usr/share/shock-os-imager/cache/images/"${imagevar}.img.xz"

fi



















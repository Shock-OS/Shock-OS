#!/bin/bash

#the root check element begins

if (($(id -u)!=0))
then

    echo "Script must be run as root. Exiting..."

    exit 2

fi

#the root check element ends

version="$1"

edition="$2"

arch="$3"

device="$4"

tmpdir="$5"

imagevar="${version}_${edition}_${arch}"

if [[ ! -f /usr/share/shock-os-imager/settings.ini ]]
then

    echo 'caching_enabled=TRUE
device_verification_enabled=TRUE' | tee /usr/share/shock-os-imager/settings.ini

fi

source /usr/share/shock-os-imager/settings.ini

touch "$tmpdir"/ready_indicator

{ inotifywait -m -e create,delete "$tmpdir" & echo "$!" | tee "$tmpdir"/inotifywait_killpid; } | while read -r event
do

    if [[ -f "${tmpdir}/kill_indicator" ]]
    then

        kill "$(cat "$tmpdir"/inotifywait_killpid)"

        echo "CANCELLING..."

        if [[ -f "${tmpdir}/image_download_pid" ]]
        then

            kill -9 "$(cat "$tmpdir"/image_download_pid)"

        else

            kill $$

        fi

    elif [[ ! -f "${tmpdir}/output.txt" ]]
    then

        kill "$(cat "$tmpdir"/inotifywait_killpid)"

    fi

done &

mkdir -p /usr/share/shock-os-imager/cached-images

sleep 1

echo "#Getting metadata..."

sleep 1

gpg --import "$tmpdir"/key.asc

gpg --verify "$tmpdir"/metadata.sig "$tmpdir"/metadata || { echo "ERROR: FAILED TO VERIFY METADATA"; exit 4; }

source "$tmpdir"/metadata

if [[ ! -f /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz" ]]
then

    echo "0"

    sleep 1

    echo "#Downloading image..."

    sleep 1

    url="${imagevar}_url"

    url="${!url}"

    { { wget --retry-connrefused --tries=0 --timeout=20 -O /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz" "$url" 2>&1 || rm -rf /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz"; } | sed -u 's/.* \([0-9]\+\)% .*/\1/'; } & echo "$!" | tee "$tmpdir"/image_download_pid

    sleep 1

    wait "$(cat "$tmpdir"/image_download_pid)"

    if [[ -f "${tmpdir}/kill_indicator" ]] #YES, this IS needed (mostly for if the process was cancelled during the download)
    then

        rm -rf /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz"

        exit 1

    elif [[ ! -f /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz" ]] #if file deleted because download failed
    then

        echo "ERROR: FAILED TO DOWNLOAD IMAGE"

        exit 3

    fi

fi

sig_url="${imagevar}_sig_url"

sig_url="${!sig_url}"

sleep 1

echo "#Verifying image..."

sleep 1

imagevar_compressed_sha256sum="${imagevar}_compressed_sha256sum"

compressed_sha256sum="$(pv -n /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz" | sha256sum | cut -d' ' -f1)"

if [[ "$compressed_sha256sum" != "${!imagevar_compressed_sha256sum}" ]]
then

    echo 'ERROR: INVALID SHA256SUM, IMAGE IS CORRUPTED.'

    exit 5

fi

sleep 1

echo "#Getting signature..."

sleep 1

wget --retry-connrefused --tries=0 --timeout=5 -q -O "$tmpdir"/"${imagevar}.img.xz.sig" "$sig_url" || { echo 'ERROR: FAILED TO DOWNLOAD SIGNATURE'; exit 3; }

gpg --verify "$tmpdir"/"${imagevar}.img.xz.sig" /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz" || { echo 'ERROR: IMAGE FILE DID NOT MATCH SIGNATURE.'; exit 5; }

sleep 1

echo "#Writing image..."

sleep 1

umount $device*

image_size=$(xz -l /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz" | awk 'NR==2 {print $5}')

image_size=$(echo "$image_size" | sed 's/,//g' | cut -d '.' -f 1)

image_size=$((image_size*1024*1024))

dd_output="$(xz -cd /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz" | pv -s "$image_size" -n | dd of=$device bs=4M 2>&1)"

echo "DD_OUTPUT: $dd_output" #DEBUG

sleep 1

echo "#Verifying device..."

sleep 1

uncompressed_size="$(echo "$dd_output" | awk 'NR==3 {print $1}')"

device_sha256sum="$(dd if="$device" bs=4M count="${uncompressed_size}B" | pv -s "$uncompressed_size" -n | sha256sum | cut -d' ' -f1)"

imagevar_uncompressed_sha256sum="${imagevar}_uncompressed_sha256sum"

if [[ "$device_sha256sum" != "${!imagevar_uncompressed_sha256sum}" ]]
then

    echo 'ERROR: VERIFICATION FAILED, AN ERROR OCCURRED WHILE FLASHING.'

    exit 6

fi

if [[ "$caching_enabled" == "FALSE" ]]
then

    rm -rf /usr/share/shock-os-imager/cached-images/"${imagevar}.img.xz"

fi



















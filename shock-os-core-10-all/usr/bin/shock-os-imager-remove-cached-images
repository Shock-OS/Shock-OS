#!/bin/bash

function yad() {

GDK_BACKEND=x11 yad $@

}

if [[ "$1" == "--nospace" ]]
then

    free_space="$(df -B 1G / | awk 'NR==2 {print $4}')"

    text="Your system only has $free_space GBs of space left, which is not sufficient to download an image of Shock OS to flash. Shock OS Imager requires a minimum of 5 GBs of free space to download a new image. "

fi

if (($(ls /usr/share/shock-os-imager/cached-images | wc -l)>1)) #plural
then

    text+="There are $(ls /usr/share/shock-os-imager/cached-images | wc -l) cached images on your system, taking up a total of $(du -sh /usr/share/shock-os-imager/cached-images | awk '{print $1}') of space. Would you like to delete them?"

elif (($(ls /usr/share/shock-os-imager/cached-images | wc -l)==1)) #singular
then

    text+="There is 1 cached image on your system, taking up $(du -sh /usr/share/shock-os-imager/cached-images | awk '{print $1}') of space. Would you like to delete it?"

else #none

    yad --window-icon=shock-os-imager --image=emblem-default-symbolic --title="Shock OS Imager" --text="There are no cached images on your system." --button="Dismiss"\!gtk-cancel

    exit

fi

yad --width=600 --window-icon=shock-os-imager --title="Shock OS Imager" --text="$text" --button="Yes, remove"\!gtk-ok --button="No, keep"\!gtk-cancel

ex=$?

if ((ex==0))
then

    pkexec rm -rf /usr/share/shock-os-imager/cached-images/*

    yad --window-icon=shock-os-imager --image=emblem-default-symbolic --title="Shock OS Imager" --text="All cached images have been successfully removed." --button="Dismiss"\!gtk-cancel

fi

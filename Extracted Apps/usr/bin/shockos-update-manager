#!/bin/bash

source /usr/lib/shockos/dist-info.sh

if [[ "$SHOCKOS_DE_EDITION" == "MATE" ]]
then
    if (($(ps aux | awk '{print $1,$11,$12}' | grep -c "$(whoami) /bin/bash /usr/bin/shockos-update-manager")>2)) #exits the program if it is already running for this user
    then
        wmctrl -Fa "Update Manager"
        exit
    fi
fi

IFS=$'\n'

function yad() {
GDK_BACKEND=x11 /usr/bin/yad "$@"
}

automatic_updates=""
notify_of_new_versions_of_shockos_os=""

#THE SETTINGS FUNCTION BEGINS
function settings() {
if [[ -f /etc/sudoers.d/shockos_automatic_updates ]] #if automatic updates are enabled
then
    automatic_updates="TRUE"
else #if disabled
    automatic_updates="FALSE"
fi

if [[ ! -f /usr/share/shockos-update-manager/disable-release-upgrader-indicator ]] #if notification of new versions of Shock OS is enabled
then
    notify_of_new_versions_of_shockos_os="TRUE"
else #if disabled
    notify_of_new_versions_of_shockos_os="FALSE"
fi

if [[ -f /usr/share/shockos-update-manager/update-scan-interval ]]
then
    interval=$(cat /usr/share/shockos-update-manager/update-scan-interval)
else
    interval=1440 #24 hours
fi

hours=$((interval/60))
if ((hours>0))
then
    minutes=$((interval%60))
else
    minutes=$interval
fi
success="FALSE"
until [[ "$success" == "TRUE" ]]
do
    output="$(yad --window-icon=software-update-available --width=100 --title="Settings" --form \
                --field="Delay between each scan for updates:":LBL "" \
                --field="Hours:":NUM "${hours}\!0..96" \
                --field="Minutes:":NUM "${minutes}\!0..59" \
                --field="":LBL "" \
                --field="If enabled, automatic updates will as root on a daily basis. You cannot log out, shutdown, or restart the system while automatic updates are being applied.":LBL "" \
                --field="Automatic updates":CHK "$automatic_updates" \
                --field="":LBL "" \
                --field="If enabled, you will be notified when an upgrade to a new version of Shock OS is available.":LBL "" \
                --field="Notify me of new versions of Shock OS":CHK "$notify_of_new_versions_of_shockos_os" \
                --buttons-layout=edge \
                --button="Cancel"\!gtk-cancel:1 --button="Apply"\!gtk-ok:0)"
    ex=$?
    if ((ex==0))
    then
        hours="$(echo "$output" | awk 'BEGIN {FS="|" } { print $2 }')"
        minutes="$(echo "$output" | awk 'BEGIN {FS="|" } { print $3 }')"
        automatic_updates="$(echo "$output" | awk 'BEGIN {FS="|" } { print $6 }')"
        notify_of_new_versions_of_shockos_os="$(echo "$output" | awk 'BEGIN {FS="|" } { print $9 }')"
        minutes=$((hours*60+minutes))
        if ((minutes<5))
        then
            yad --window-icon=emblem-important --title="Update Manager" --text="The delay between each scan for updates must be a minimum of five minutes." --button="Retry"\!edit-undo
        else    
            pkexec shockos-update-manager-pkexec-settings-script "$automatic_updates" "$notify_of_new_versions_of_shockos_os" "$minutes"
            success="TRUE"
        fi
    else
        success="TRUE"
    fi
done
}

#THE SETTINGS FUNCTION ENDS
function wait_apt_lock() {
mkdir -p ~/.cache/shockos-tmp/shockware-center
until (($(lslocks | grep -c apt)==0)) && [[ ! -f ~/.cache/shockos-tmp/shockware-center/apt-queue ]] #waits until /var/lib/dpkg/lock-frontend is not being held
do
    echo "#Waiting for APT lock..."
    sleep 3
done
echo "#"
}

function install_updates() {
if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]] #shows updates in progress notification and stops the user from accessing the shutdown menu while updates are being applied.
then
    gsettings set org.gnome.desktop.lockdown disable-log-out "true"
    gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.CloseNotification "$(cat ~/.cache/shockos-tmp/shockos-update-manager/gnome_updates_available_notification_id)"
    rm ~/.cache/shockos-tmp/shockos-update-manager/gnome_updates_available_notification_id
    if ((all_updates_num>1))
    then
        notification_title="Installing Updates"
    else
        notification_title="Installing an Update"
    fi
    notify-send -w --icon=software-update-available --app-name="Update Manager" "$notification_title" "Please do not turn off your computer." & notification_killpid=$!
else #MATE
    gsettings set org.mate.lockdown disable-log-out "true"
    kill "$(cat ~/.cache/shockos-tmp/shockos-update-manager/mate_updates_available_indicator_pid)"
    rm ~/.cache/shockos-tmp/shockos-update-manager/mate_updates_available_indicator_pid
    if ((all_updates_num>1))
    then
        notification_text="Updates are being installed. Please do not turn off your computer."
    else
        notification_text="An update is being installed. Please do not turn off your computer."
    fi
    /usr/bin/yad --notification --image=software-update-available --text="$notification_text" --command='' & notification_killpid=$!
fi
mkdir -p ~/.cache/shockos-tmp/shockos-update-manager
echo "$notification_killpid" | tee ~/.cache/shockos-tmp/shockos-update-manager/updates_in_progress_indicator_pid
apt_ex_tmpfile="$(mktemp)"
if [[ " ${all_updates[@]} " == *" /usr/share/shockos-update-manager/apt.svg "* ]] #if APT updates are available
then
    { wait_apt_lock; { pkexec env DEBIAN_FRONTEND=gnome apt-get upgrade --show-progress -y; echo "$?" | tee "$apt_ex_tmpfile"; } | stdbuf -o0 grep 'Progress:' | stdbuf -o0 grep -oP '\d+(?=%)' | (echo "#Downloading updates, please wait..."; stdbuf -o0 sed 's/.*/&\n#&%/g'); } | yad --window-icon=software-update-available --image=software-update-available --width=400 --title="Update Manager" --text="Installing APT Updates...
<small>Updates will continue in the background if this window is closed.</small>" --text-align=center --fixed --progress --auto-close --no-cancel  --no-buttons --no-esape
else
    echo "SKIP" | tee "$apt_ex_tmpfile"
fi
flatpak_ex_tmpfile="$(mktemp)"
if [[ " ${all_updates[@]} " == *" /usr/share/shockos-update-manager/flatpak.svg "* ]] #if Flatpak updates are available
then
    { flatpak update -y; echo "$?" | tee "$flatpak_ex_tmpfile"; } | stdbuf -o0 grep 'Installing' | while read progress
    do
        current_progress="$(echo "$progress" | grep -oP '\d+(?=%)')"
        flatpak_counter="$(echo "$progress" | grep -oE "[0-9]+/[0-9]+")"
        current_flatpak="${flatpak_counter%%/*}"
        total_flatpaks="${flatpak_counter#*/}"
        if (($(echo "$flatpak_counter" | wc -l)==1))
        then
            if [[ -z "$flatpak_counter" ]]
            then
                percentage="$current_progress"
            else
                percentage=$(($(($((current_flatpak-1))*100/total_flatpaks))+$((current_progress/total_flatpaks))))
            fi
            echo "${percentage}n"
            echo "#${percentage}%"
        fi
    done | yad --window-icon=software-update-available --image=software-update-available --width=400 --title="Update Manager" --text="Installing Flatpak Updates...
<small>Updates will continue in the background if this window is closed.</small>" --text-align=center --fixed --progress --auto-close --no-cancel  --no-buttons --no-esape
else
    echo "SKIP" | tee "$flatpak_ex_tmpfile"
fi
rm ~/.cache/shockos-tmp/shockos-update-manager/updates_in_progress_indicator_pid
kill -2 "$notification_killpid"
if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]] #allows the user to access the shutdown menu.
then
    gsettings set org.gnome.desktop.lockdown disable-log-out "false"
else #MATE
    gsettings set org.mate.lockdown disable-log-out "false"
fi
}

function fetch_cache() {
all_updates=($(cat /usr/share/shockos-update-manager/cache))
all_updates_num=$(("${#all_updates[@]}"/2))
}
fetch_cache
if ((all_updates_num==0))
then
    kill "$(cat ~/.cache/shockos-tmp/shockos-update-manager/indicator_pid)"
    rm ~/.cache/shockos-tmp/shockos-update-manager/indicator_pid
    yad --window-icon=emblem-default --image=emblem-default --buttons-layout=edge --title="Update Manager" --text="Your system is up to date." --button="Settings"\!tweaks-app --button="Dismiss"\!gtk-cancel --width=300
    ex=$?
    if ((ex==0)) #settings
    then
        settings
    fi
    exit
elif ((all_updates_num==1))
then
    window_text="1 update is available."
else
    window_text="$all_updates_num updates are available."
fi
page=0
while true
do
    yad --window-icon=software-update-available --title="Update Manager" --width=800 --height=500 --text="$window_text" --list \
        --no-click \
        --dclick-action="" \
        --column="Type":IMG \
        --column="Name" \
        --buttons-layout=edge \
        $page_buttons \
        --button="Settings"\!tweaks-app:1 --button="Install Updates"\!software-update-available:2 \
        "${all_updates[@]}"
    ex=$?
    if ((ex==1)) #settings
    then
        settings
    elif ((ex==2)) #install updates
    then
        install_updates
        #the following line uses '/usr/bin/yad' to avoid calling the yad function
        /usr/bin/yad --window-icon=software-update-available --title="Update Manager" --progress-text="Refreshing cache..." --center --progress --pulsate --auto-close --undecorated --no-buttons --skip-taskbar & refresh_killpid=$!
        sudo shockos-update-manager-refresh
        apt_ex="$(cat "$apt_ex_tmpfile")"
        flatpak_ex="$(cat "$flatpak_ex_tmpfile")"
        rm "$apt_ex_tmpfile"
        rm "$flatpak_ex_tmpfile"
        kill -9 $refresh_killpid
        if [[ "$apt_ex" == "SKIP" || "$apt_ex" == "0" || "$apt_ex" == "126" || "$apt_ex" == "127" ]] && [[ "$flatpak_ex" == "SKIP" || "$flatpak_ex" == "0" ]]
        then
            kill "$(cat ~/.cache/shockos-tmp/shockos-update-manager/indicator_pid)"
            rm ~/.cache/shockos-tmp/shockos-update-manager/indicator_pid
	        notify-send --icon=software-update-available --app-name="Update Manager" "Update Manager" "Your system is up to date."
        else
            yad --window-icon=software-update-available --image=emblem-important --title="Update Manager" --text="Failed to install the updates. Please double check your internet connection and try again later." --button="Dismiss"\!gtk-close
        fi
        exit
    else
        exit
    fi
done


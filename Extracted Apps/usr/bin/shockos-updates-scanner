#!/bin/bash

IFS=$'\n'

function yad() {
GDK_BACKEND=x11 /usr/bin/yad "$@"
}

source /usr/lib/shockos/dist-info.sh

#this script checks for available updates and sends a notification if any are available

while true
do
    rm ~/.cache/shockos-update-manager/indicator_pid
    sudo shockos-update-manager-refresh
    updates=$(cat /usr/share/shockos-update-manager/cache | wc -l)
    updates=$((updates/2)) #divides updates array by two because there are two columns (Name and Type) for each updates
    if ((updates>0))
    then
        if [[ -f /etc/sudoers.d/shockos_automatic_updates ]] #if automatic updates are enabled
        then
            if (($(ps aux | awk '{print $1,$11,$12}' | grep -c "root /bin/bash /usr/bin/shockos-auto-updates")<=2)) #installs automatic updates if they aren't already running
            then
                if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]] #stops the user from accessing the shutdown menu while automatic updates are being applied.
                then
                    gsettings set org.gnome.desktop.lockdown disable-log-out "true"
                else #MATE
                    gsettings set org.mate.lockdown disable-log-out "true"
                fi
                sudo shockos-auto-updates & auto_updates_killpid=$!
            else
                auto_updates_killpid="$(ps aux | grep "root" | grep "/usr/bin/shockos-auto-updates" | awk '{print $2}')"
            fi
            GDK_BACKEND=x11 /usr/bin/yad --notification --image=aptdaemon-upgrade --icon-size=48 --text="Automatic updates are being installed. Please do not turn off your computer." --command="" & killpid=$!
            if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]]
            then
                notify-send -w --app-name="Update Manager" --icon=aptdaemon-upgrade "Automatic Updates" "Automatic updates are being installed. Please do not turn off your computer." & gnome_notification_killpid=$!
            fi
            wait $auto_updates_killpid
            kill $killpid
            if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]] #allows the user to access the shutdown menu.
            then
                kill "$gnome_notification_killpid"
                gsettings set org.gnome.desktop.lockdown disable-log-out "false"
            else #MATE
                gsettings set org.mate.lockdown disable-log-out "false"
            fi
        else
            if ((updates>1))
            then
                if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]]
                then
                    notification_title="Updates Are Available"
                    notification_text="Click to install them."
                else #MATE
                    notification_text="$updates updates are available."
                    yad_text="$updates updates are available. Click to install them."
                fi
            else
                if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]]
                then
                    notification_title="An Update Is Available"
                    notification_text="Click to install it."
                else #MATE
                    yad_text="An update is available. Click to install it."
                    notification_text="An update is available."
                fi
            fi
            mkdir -p ~/.cache/shockos-tmp/shockos-update-manager
            if [[ "$SHOCKOS_DE_EDITION" == "GNOME" ]]
            then
                ex="$(python3 /usr/bin/shockos-shared-function-send-notification.py --title="$notification_title" --text="$notification_text" --icon=software-update-available --idfile="/home/$(whoami)/.cache/shockos-tmp/shockos-update-manager/gnome_updates_available_notification_id")"
                if [[ "$ex" == "0" ]]
                then
                    /bin/bash /usr/bin/shockos-update-manager
                fi
            else #MATE
                GDK_BACKEND=x11 /usr/bin/yad --notification --image=software-update-available --text="$yad_text" --command='/bin/bash /usr/bin/shockos-update-manager' & killpid=$!
                echo "$killpid" | tee ~/.cache/shockos-tmp/shockos-update-manager/mate_updates_available_indicator_pid
                wait $killpid
            fi
            if [[ -f ~/.cache/shockos-tmp/shockos-update-manager/updates_in_progress_indicator_pid ]] #if updates are being installed, wait for them to finish.
            then
                wait "$(cat ~/.cache/shockos-tmp/shockos-update-manager/updates_in_progress_indicator_pid)"
            fi
        fi
    fi
    shockos-shared-function-sleep-update-scan-interval
done

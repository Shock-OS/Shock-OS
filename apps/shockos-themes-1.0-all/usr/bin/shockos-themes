#!/usr/bin/env python3

import sys
sys.path.append('/usr/lib/shockos/')
import shockos
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk
gi.require_version('Gio', '2.0')
from gi.repository import Gio
import argparse

parser = argparse.ArgumentParser(description="Simple theme selector for Shock OS")

parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")

args = parser.parse_args()
def log(message):
    if args.verbose:
        print(message)

class app(Gtk.Application):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.connect('activate', self.on_activate)

    def on_activate(self, app):
        # Create a Builder
        builder = Gtk.Builder()
        builder.add_from_file("/usr/share/shockos/themes/main.ui")

        # Obtain GSettings schemas
        self.gnome_interface_settings = Gio.Settings.new("org.gnome.desktop.interface")
        if shockos.deskenv == "MATE":
            self.mate_interface_settings = Gio.Settings.new("org.mate.interface")
            self.marco_settings = Gio.Settings.new("org.mate.Marco.general")
        elif shockos.deskenv == "GNOME":
            self.gnome_shell_settings = Gio.Settings.new("org.gnome.shell.extensions.user-theme")

        # Obtain the widgets
        self.lod_cb = builder.get_object("lod_cb")
        self.color_cb = builder.get_object("color_cb")

        # Order matters here
        self.get_current_setting()
        self.lod_cb.connect("changed", self.on_cbs_changed)
        self.color_cb.connect("changed", self.on_cbs_changed)

        # Obtain and show the main window
        self.main_window = builder.get_object("main_window")
        self.main_window.set_application(self)  # Application will close once it no longer has active windows attached to it
        self.main_window.present()

    def get_current_setting(self):
        try:
            if shockos.deskenv == "GNOME":
                theme = self.gnome_interface_settings.get_string("gtk-theme")
            elif shockos.deskenv == "MATE":
                theme = self.mate_interface_settings.get_string("gtk-theme")
            if theme == "Yaru":
                lod = "light"
                color = "orange"
            elif theme == "Yaru-dark":
                lod = "dark"
                color = "orange"
            else:
                parts = theme.split("-")
                try:
                    lod = parts[2]
                except:
                    lod = "light"
                color = parts[1]
        except:
            lod=''
            color=''
        self.lod_cb.set_active_id(lod)
        self.color_cb.set_active_id(color)
        log(f"LOD: {lod}")
        log(f"COLOR: {color}")

    def on_cbs_changed(self, widget):
        lod = self.lod_cb.get_active_id()
        if lod == "light":
            lod = ""
        else:
            lod = "-dark"
        color = self.color_cb.get_active_id()
        if color == "orange":
            color = ""
        else:
            color = f"-{color}"
        theme = f"Yaru{color}{lod}"
        self.gnome_interface_settings.set_string("gtk-theme", theme)
        self.gnome_interface_settings.set_string("icon-theme", theme)
        if shockos.deskenv_is_gnome:
            self.gnome_shell_settings.set_string("name", theme)
        elif shockos.deskenv_is_mate:
            self.mate_interface_settings.set_string("gtk-theme", theme)
            self.mate_interface_settings.set_string("icon-theme", theme)
            if lod == "-dark":
                self.marco_settings.set_string("theme", "Yaru-dark")
            else:
                self.marco_settings.set_string("theme", "Yaru")
        if lod == "-dark":
            self.gnome_interface_settings.set_string("color-scheme", "prefer-dark")
        else:
            self.gnome_interface_settings.set_string("color-scheme", "prefer-light")
        log(f"THEME: {theme}")

app = app(application_id="net.ShockOS.Themes")
app.run()


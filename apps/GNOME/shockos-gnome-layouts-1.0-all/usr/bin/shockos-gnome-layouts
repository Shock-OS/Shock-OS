#!/usr/bin/env python3

import argparse
import subprocess
import sys
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gio

parser = argparse.ArgumentParser(description="Change the GNOME layout")
parser.add_argument("--verbose", action="store_true", help="Increase output verbosity (print variables)")
args = parser.parse_args()

verbose = args.verbose

class MyApp(Gtk.Application):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.connect('activate', self.on_activate)

    def on_activate(self, app):
        # Create a Builder
        builder = Gtk.Builder()
        builder.add_from_file("/usr/share/shockos/gnome/shockos-gnome-layouts/main.ui")

        # Get toggle buttons
        self.panel_mode_button = builder.get_object("panel_mode_button")
        self.dock_mode_button = builder.get_object("dock_mode_button")
        self.vanilla_mode_button = builder.get_object("vanilla_mode_button")
        self.reset_button = builder.get_object("reset_button")
        self.reset_button.connect("clicked", self.reset)
        self.close_button = builder.get_object("close_button")
        self.close_button.connect("clicked", self.quit)

        # Group the buttons
        self.dock_mode_button.set_group(self.panel_mode_button)
        self.vanilla_mode_button.set_group(self.panel_mode_button)
        
        # Get the current layout mode
        panel_mode_state = subprocess.run(["gnome-extensions info dash-to-panel@jderose9.github.com | grep State: | awk -F': ' '{print $2}' | tr -d '[:space:]'"], shell=True, capture_output=True, text=True)
        if verbose:
            print(f"PANEL_MODE_STATE: {panel_mode_state.stdout}")
        if panel_mode_state.stdout == "ENABLED":
            if verbose:
                print("Current layout: panel")
            self.panel_mode_button.set_active(True)
        else:
            dock_mode_state = subprocess.run(["gnome-extensions info dash-to-dock@micxgx.gmail.com | grep State: | awk -F': ' '{print $2}' | tr -d '[:space:]'"], shell=True, capture_output=True, text=True)
            if verbose:
                print(f"DOCK_MODE_STATE: {dock_mode_state.stdout}")
            if dock_mode_state.stdout == "ENABLED":
                if verbose:
                    print(f"Current layout: dock")
                self.dock_mode_button.set_active(True)
            else:
                if verbose:
                    print("Neither dock mode nor panel mode are enabled, assuming vanilla mode is set.")
                self.vanilla_mode_button.set_active(True)
        
        # Connect the toggled signals of the buttons
        self.panel_mode_button.connect("toggled", self.panel_mode_toggled)
        self.dock_mode_button.connect("toggled", self.dock_mode_toggled)
        self.vanilla_mode_button.connect("toggled", self.vanilla_mode_toggled)

        # Get and show the main window
        self.main_window = builder.get_object("main_window")
        self.main_window.set_application(self) # Application will close once it no longer has active windows
        self.main_window.present()

    def panel_mode_toggled(self, button):
        if self.panel_mode_button.get_active():
            if verbose:
                print("Panel mode selected")
            subprocess.run(['gnome-extensions', 'disable', 'dash-to-dock@micxgx.gmail.com'])
            subprocess.run(['gnome-extensions', 'enable', 'dash-to-panel@jderose9.github.com'])
            subprocess.run(['gnome-extensions', 'enable', 'arcmenu@arcmenu.com'])
            subprocess.run(['gnome-extensions', 'enable', 'ding@rastersoft.com'])
            subprocess.run(['gnome-extensions', 'enable', 'panel-osd@berend.de.schouwer.gmail.com'])
            subprocess.run(['gnome-extensions', 'enable', 'no-overview@fthx'])

    def dock_mode_toggled(self, button):
        if self.dock_mode_button.get_active():
            if verbose:
                print("Dock mode selected")
            subprocess.run(['gnome-extensions', 'disable', 'ding@rastersoft.com'])
            subprocess.run(['gnome-extensions', 'disable', 'arcmenu@arcmenu.com'])
            subprocess.run(['gnome-extensions', 'disable', 'dash-to-panel@jderose9.github.com'])
            subprocess.run(['gnome-extensions', 'disable', 'panel-osd@berend.de.schouwer.gmail.com'])
            subprocess.run(['gnome-extensions', 'enable', 'dash-to-dock@micxgx.gmail.com'])
            subprocess.run(['gnome-extensions', 'enable', 'no-overview@fthx'])

    def vanilla_mode_toggled(self, button):
        if self.vanilla_mode_button.get_active():
            if verbose:
                print("Vanilla mode selected")
            subprocess.run(['gnome-extensions', 'disable', 'ding@rastersoft.com'])
            subprocess.run(['gnome-extensions', 'disable', 'arcmenu@arcmenu.com'])
            subprocess.run(['gnome-extensions', 'disable', 'dash-to-panel@jderose9.github.com'])
            subprocess.run(['gnome-extensions', 'disable', 'panel-osd@berend.de.schouwer.gmail.com'])
            subprocess.run(['gnome-extensions', 'disable', 'dash-to-dock@micxgx.gmail.com'])
            subprocess.run(['gnome-extensions', 'disable', 'no-overview@fthx'])

    def reset(self, button):
        subprocess.run(['gsettings', 'reset-recursively', 'org.gnome.shell.extensions.dash-to-panel'])
        subprocess.run(['gsettings', 'reset-recursively', 'org.gnome.shell.extensions.dash-to-dock'])
        subprocess.run(['gsettings', 'reset-recursively', 'org.gnome.shell.extensions.appindicator'])
        subprocess.run(['gnome-extensions', 'enable', 'ubuntu-appindicators@ubuntu.com'])

    def quit(self, button):
        sys.exit()

app = MyApp(application_id="net.shockos.GNOME.Layouts", flags=Gio.ApplicationFlags.NON_UNIQUE)
app.run()

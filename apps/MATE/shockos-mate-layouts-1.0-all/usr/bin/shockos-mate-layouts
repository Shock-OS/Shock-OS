#!/usr/bin/env python3

import sys
import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Gio', '2.0')
from gi.repository import Gtk, Gio
import argparse
import subprocess

parser = argparse.ArgumentParser(description="Desktop layout selector for Shock OS MATE Edition")

parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")

args = parser.parse_args()
def log(message):
    if args.verbose:
        print(message)

class app(Gtk.Application):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.connect('activate', self.on_activate)

    def on_activate(self, app):
        # Create a Builder
        builder = Gtk.Builder()
        builder.add_from_file("/usr/share/shockos/mate/shockos-mate-layouts/main.ui")

        self.mate_session_settings = Gio.Settings.new("org.mate.session.required-components")
        self.mate_panel_settings = Gio.Settings.new("org.mate.panel")

        # Obtain the widgets
        self.panel_mode_button = builder.get_object("panel_mode_button")
        self.dock_mode_button = builder.get_object("dock_mode_button")
        self.dock_mode_button.set_group(self.panel_mode_button)
        self.trad_mode_button = builder.get_object("trad_mode_button")
        self.trad_mode_button.set_group(self.panel_mode_button)
        self.reset_button = builder.get_object("reset_button")
        self.reset_button.connect("clicked", self.reset)
        self.close_button = builder.get_object("close_button")
        self.close_button.connect("clicked", self.close)

        # Get current layout
        layout = self.mate_panel_settings.get_string('default-layout')
        if layout == 'shockos-panel':
            self.panel_mode_button.set_active(True)
        elif layout == 'shockos-dock':
            self.dock_mode_button.set_active(True)
        elif layout == 'shockos-traditional':
            self.trad_mode_button.set_active(True)

        # Connect buttons to functions
        self.panel_mode_button.connect("toggled", self.panel_mode_toggled)
        self.dock_mode_button.connect("toggled", self.dock_mode_toggled)
        self.trad_mode_button.connect("toggled", self.trad_mode_toggled)

        # Obtain and show the main window
        self.main_window = builder.get_object("main_window")
        self.main_window.set_application(self)  # Application will close once it no longer has active windows attached to it
        self.main_window.present()

    def panel_mode_toggled(self, button):
        if self.panel_mode_button.get_active():
            self.mate_session_settings.set_string('dock', '')
            self.mate_panel_settings.set_string('default-layout', 'shockos-panel')
            subprocess.run(['pkill', '-x', 'plank'])
            subprocess.run(['mate-panel', '--reset'])

    def dock_mode_toggled(self, button):
        if self.dock_mode_button.get_active():
            self.mate_session_settings.set_string('dock', 'plank')
            self.mate_panel_settings.set_string('default-layout', 'shockos-dock')
            subprocess.run(['mate-panel', '--reset'])
            subprocess.Popen(['sleep 0.5; plank'], shell=True)

    def trad_mode_toggled(self, button):
        if self.trad_mode_button.get_active():
            self.mate_session_settings.set_string('dock', '')
            self.mate_panel_settings.set_string('default-layout', 'shockos-traditional')
            subprocess.run(['pkill', '-x', 'plank'])
            subprocess.run(['mate-panel', '--reset'])

    def reset(self, button):
        subprocess.run(['mate-panel', '--reset'])
        subprocess.run(['/usr/libexec/shockos/mate/reset-plank.sh'])

    def close(self, button):
        sys.exit()

app = app(application_id="net.ShockOS.MATE.Layouts")
app.run()


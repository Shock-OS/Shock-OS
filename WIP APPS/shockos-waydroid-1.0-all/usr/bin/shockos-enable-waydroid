#!/bin/bash

source /usr/lib/shockos/shockos-dist-info.sh

function get_win_size {
local width=$(tput cols)
local height=$(tput lines)
echo "$((height-10)) $((width-10))"
}

shopt -s expand_aliases  # Enable alias expansion
alias whiptail="whiptail --backtitle='EXPERIMENTAL WAYDROID SETUP'"

whiptail --title="WELCOME" --msgbox "Welcome to the Waydroid setup wizard. Here you can enable support for running Android applications on your system. Please keep in mind that this feature is currently experimental, and you are likely to encounter issues.

WARNING: Enabling Android app support may require modifying your kernel. Installing Android support also requires at least 5 GB of free space." $(get_win_size) --ok-button="Continue"
if [[ "$SHOCKOS_DESKENV" == "MATE" ]]
then
    whiptail --title="MATE EDITION DETECTED" --msbox "You are currently running the MATE Edition of Shock OS, which still uses X11. You will still be able to run Waydroid, but only in a nested Wayland compositor. The desktop integration feature is unavailable for the MATE Edition, but you can still run an Android session in its own window." $(get_win_size) --ok-button="I Understand"
fi
whiptail --title="CONFIRM INSTALLATION" --yesno "Are you sure you want to enable experimental Android app support?

Things to know:
1. At least 5 GB of free space is recommended
2. Your kernel may be modified in order for Waydroid to run properly" $(get_win_size) --yes-button="Install Waydroid" --no-button="Cancel"
ex=$?
if [[ "$ex" == "0" ]]
then
    # BEGINNING INSTALLATION OF WAYDROID
    sudo apt update
    sudo apt upgrade -y
    sudo apt install curl lsb-release apkinfo # apkinfo used by Package Manager
    if [[ "$(getconf PAGESIZE)" != "4096" ]] # If kernel page size not set to 4K (it's usually set to 16K on Pi 5 systems)
    then
        echo "Setting kernel page size to 4K..."
        sudo sed -i '1i kernel=kernel8.img' /boot/firmware/config.txt
    fi
    echo "Enabling PSI in kernel..."
    sudo sed -i '$ s/$/ psi=1/' /boot/firmware/cmdline.txt
    sudo curl -Sf https://repo.waydro.id/waydroid.gpg --output /usr/share/keyrings/waydroid.gpg
    echo "deb [signed-by=/usr/share/keyrings/waydroid.gpg] https://repo.waydro.id/ $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/waydroid.list
    sudo apt update
    sudo apt install -y waydroid || { echo "ERROR: Failed to install Waydroid. Please check your internet connection and try again later."; exit 1; }
    whiptail --title="READY TO REBOOT" --yesno "Android app support has been installed successfully. Please reboot for changes to take full effect, then launch Waydroid from the applications menu to get started." $(get_win_size) --yes-button="Reboot Now" --no-button="Reboot Later"
    ex=$?
    if [[ "$ex" == "0" ]]
    then
        sudo reboot
    fi
else
    whiptail --title="INSTALLATION CANCELLED" --msbox "The installation of Waydroid was cancelled. Android app support was not enabled on your system. No changes were made." $(get_win_size) --ok-button="Exit"
fi

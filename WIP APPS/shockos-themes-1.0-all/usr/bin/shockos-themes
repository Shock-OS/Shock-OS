#!/usr/bin/env python3

import sys
sys.path.append('/usr/lib/shockos/')
import shockos_dist_info
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk
gi.require_version('Gio', '2.0')
from gi.repository import Gio
import argparse

parser = argparse.ArgumentParser(description="Simple theme selector for Shock OS")

parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")

args = parser.parse_args()

verbose = args.verbose

class app(Gtk.Application):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.connect('activate', self.on_activate)

    def on_activate(self, app):
        # Create a Builder
        builder = Gtk.Builder()
        builder.add_from_file("/usr/share/shockos/themes/main.ui")

        # Obtain GSettings schemas
        if shockos_dist_info.edition == "MATE":
            self.settings = Gio.Settings.new("org.mate.interface")
            self.marco_settings = Gio.Settings.new("org.mate.Marco.general")

        # Obtain the widgets
        self.lod_cb = builder.get_object("lod_cb")
        self.color_cb = builder.get_object("color_cb")

        # Order matters here
        self.get_current_setting()
        self.lod_cb.connect("changed", self.on_cbs_changed)
        self.color_cb.connect("changed", self.on_cbs_changed)

        # Obtain and show the main window
        self.main_window = builder.get_object("main_window")
        self.main_window.set_application(self)  # Application will close once it no longer has active windows attached to it
        self.main_window.present()

    def get_current_setting(self):
        theme = self.settings.get_string("gtk-theme")
        if theme == "Yaru":
            lod = "light"
            color = "orange"
        elif theme == "Yaru-dark":
            lod = "dark"
            color = "orange"
        else:
            parts = theme.split("-")
            try:
                lod = parts[2]
            except:
                lod = "light"
            color = parts[1]
        self.lod_cb.set_active_id(lod)
        self.color_cb.set_active_id(color)
        if verbose:
            print(f"LOD: {lod}")
            print(f"COLOR: {color}")

    def on_cbs_changed(self, widget):
        lod = self.lod_cb.get_active_id()
        if lod == "light":
            lod = ""
        else:
            lod = "-dark"
        color = self.color_cb.get_active_id()
        if color == "orange":
            color = ""
        else:
            color = f"-{color}"
        theme = f"Yaru{color}{lod}"
        self.settings.set_string("gtk-theme", theme)
        self.settings.set_string("icon-theme", theme)
        if shockos_dist_info.edition == "MATE":
            if lod == "-dark":
                self.marco_settings.set_string("theme", "Yaru-dark")
            else:
                self.marco_settings.set_string("theme", "Yaru")
        if verbose:
            print(f"THEME: {theme}")

app = app(application_id="net.ShockOS.Themes")
app.run()


	(1,9,"GtkLabel","label","Compatibility mode",0,None,None,None,None,None,None,None,None),
	(1,11,"GtkLabel","label","The Raspberry Pi 5 kernel uses a 16K page size by default, while older Pi boards use 4K page sizes by default. This increased page size can improve performance, but at a cost of compatibility. Many Pi programs require a 4K page size to function properly. Waydroid, the software used to power the experimental Android app support feature, also requires 4K page sizes. If you experience problems running software that works on older Pi boards, consider enabling this option.",None,None,None,None,None,None,None,None,None),

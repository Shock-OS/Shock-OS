#!/usr/bin/env python3

import sys
sys.path.append('/usr/lib/shockos/')
import shockos
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gio, GLib
import argparse
import subprocess
import threading
from pathlib import Path

parser = argparse.ArgumentParser(description="Easily configure Waydroid")

parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")

args = parser.parse_args()

def log(message):
    if args.verbose:
        print(message)

class WaydroidSettings(Gtk.Application):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.connect('activate', self.on_activate)

    def on_activate(self, app):
        # Create a Builder
        builder = Gtk.Builder()
        builder.add_from_file("/usr/share/shockos/waydroid/shockos-waydroid-settings/main.ui")

        # Obtain the widgets
        self.status_label = builder.get_object("status_label")
        self.start_session_button = builder.get_object("start_session_button")
        self.start_session_button.connect("clicked", self.session_manager, "start")
        self.stop_and_restart_box = builder.get_object("stop_and_restart_box")
        self.stop_session_button = builder.get_object("stop_session_button")
        self.stop_session_button.connect("clicked", self.session_manager, "stop")
        self.restart_session_button = builder.get_object("restart_session_button")
        self.restart_session_button.connect("clicked", self.session_manager, "restart")
        self.spinner = builder.get_object("spinner")
        self.session_type_box = builder.get_object("session_type_box")
        if shockos.deskenv == 'GNOME':
            self.session_type_cb = builder.get_object("session_type_cb")
            self.settings = Gio.Settings.new("net.shockos.Waydroid")
            self.settings.bind("session-type", self.session_type_cb, "active-id", Gio.SettingsBindFlags.DEFAULT)
        else:
            self.session_type_box.set_visible(False)
        self.requires_active_session_box = builder.get_object("requires_active_session_box")
        self.multi_windows_box = builder.get_object("multi_windows_box")
        self.multi_windows_switch = builder.get_object("multi_windows_switch")
        self.multi_windows_switch.connect("notify", self.toggle_multi_windows)
        self.gplay_id_entry = builder.get_object("gplay_id_entry")
        self.get_gplay_id_button = builder.get_object("get_gplay_id_button")
        self.get_gplay_id_button.connect("clicked", self.get_gplay_id)

        # Obtain and show the main window
        self.get_status()
        self.main_window = builder.get_object("main_window")
        self.main_window.set_application(self)  # Application will close once it no longer has active windows attached to it
        self.main_window.present()

    def get_status(self):
        self.spinner.set_spinning(True)
        status = subprocess.run([f"waydroid status | awk 'NR==1 {{print $2}}'"], shell=True, capture_output=True, text=True)
        status = status.stdout.strip()
        if status == "STOPPED":
            self.status_label.set_label("Stopped")
            self.start_session_button.set_sensitive(True)
            self.start_session_button.set_visible(True)
            self.stop_and_restart_box.set_visible(False)
            self.requires_active_session_box.set_sensitive(False)
        else: # if running
            self.status_label.set_label("Running")
            self.start_session_button.set_visible(False)
            self.stop_and_restart_box.set_sensitive(True)
            self.stop_and_restart_box.set_visible(True)
            propval = subprocess.run(['waydroid', 'prop', 'get', 'persist.waydroid.multi_windows'], capture_output=True, text=True)
            propval = propval.stdout.strip()
            if propval == "true":
                self.multi_windows_switch.set_active(True)
            else:
                self.multi_windows_switch.set_active(False)
            self.requires_active_session_box.set_sensitive(True)
        self.spinner.set_spinning(False)
        return False

    def session_manager(self, widget, action):
        def start_session():
            if shockos.deskenv == 'MATE' or self.settings.get_string("session-type") == 'nested':
                subprocess.run(['/usr/libexec/shockos/waydroid/start-session-nested.sh'])
            else:
                subprocess.run(['/usr/libexec/shockos/waydroid/start-session.sh'])
        def do_action():
            if action == "start":
                start_session()
            elif action == "stop":
                subprocess.run(["waydroid", "session", "stop"])
                if shockos.deskenv == 'MATE':
                    pidfile = Path.home() / '.cache' / 'shockos-tmp' / 'waydroid' / 'weston-pid'
                    if pidfile.is_file():
                        with open(pidfile, "r") as pidfile:
                            pid = pidfile.read().strip()
                        subprocess.run(['kill', pid])
            elif action == "restart":
                subprocess.run(["waydroid", "session", "stop"])
                start_session()
            GLib.idle_add(self.get_status)
        self.requires_active_session_box.set_sensitive(False)
        if action == "start":
            self.start_session_button.set_sensitive(False)
            self.status_label.set_label("Starting...")
            self.spinner.set_spinning(True)
        elif action == "stop":
            self.stop_and_restart_box.set_sensitive(False)
            self.status_label.set_label("Stopping...")
            self.spinner.set_spinning(True)
        elif action == "restart":
            self.stop_and_restart_box.set_sensitive(False)
            self.status_label.set_label("Restarting...")
            self.spinner.set_spinning(True)
        thread = threading.Thread(target=do_action)
        thread.daemon = True
        thread.start()

    def toggle_multi_windows(self, switch, state):
        if self.multi_windows_switch.get_active():
            subprocess.run(['waydroid', 'prop', 'set', 'persist.waydroid.multi_windows', 'true'])
        else:
            subprocess.run(['waydroid', 'prop', 'set', 'persist.waydroid.multi_windows', 'false'])

    def get_gplay_id(self, button):
        try:
            gplay_id = subprocess.run(['pkexec', '/usr/libexec/shockos/waydroid/get-gplay-id.sh'], capture_output=True, check=True, text=True)
            gplay_id = gplay_id.stdout.strip()
            self.gplay_id_entry.set_text(gplay_id)
        except subprocess.CalledProcessError as err_code:
            if err_code.returncode != "126" and err_code.returncode != "127": #if Pkexec didn't fail
                log("ERROR: Failed to get Google Services Framework Android ID")

app = WaydroidSettings(application_id="net.ShockOS.Waydroid.Settings", flags=Gio.ApplicationFlags.NON_UNIQUE)
app.run()


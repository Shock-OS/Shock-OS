#!/usr/bin/env python3

import sys
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gio
import argparse
import subprocess

parser = argparse.ArgumentParser(description="Shock OS Update Manager")

parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")

args = parser.parse_args()

verbose = args.verbose

class app(Gtk.Application):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.connect('activate', self.on_activate)

    def on_activate(self, app):
        # Create a Builder
        builder = Gtk.Builder()
        builder.add_from_file("/usr/share/shockos/update-manager/main.ui")
        builder.add_from_file("/usr/share/shockos/update-manager/preferences.ui")

        # Obtain the GSettings schema
        settings = Gio.Settings.new("net.shockos.update-manager")

        # Obtain the widgets
        # Main Window widgets
        self.preferences_button = builder.get_object("preferences_button")
        self.preferences_button.connect("clicked", self.open_preferences_menu)
        self.preferences_window = builder.get_object("preferences_window")
        self.preferences_window.connect("close-request", self.close_preferences_window)
        self.main_button = builder.get_object("main_button")

        # Preferences Window widgets
        self.initcheck_days_entry = builder.get_object("initcheck_days_entry")
        settings.bind("initcheck-days", self.initcheck_days_entry, "text", Gio.SettingsBindFlags.DEFAULT)
        self.initcheck_days_add_button = builder.get_object("initcheck_days_add_button")
        self.initcheck_days_add_button.connect("clicked", self.math)
        self.initcheck_days_sub_button = builder.get_object("initcheck_days_sub_button")
        self.initcheck_days_sub_button.connect("clicked", self.math)

        self.initcheck_hrs_entry = builder.get_object("initcheck_hrs_entry")
        settings.bind("initcheck-hrs", self.initcheck_hrs_entry, "text", Gio.SettingsBindFlags.DEFAULT)
        self.initcheck_hrs_add_button = builder.get_object("initcheck_hrs_add_button")
        self.initcheck_hrs_add_button.connect("clicked", self.math)
        self.initcheck_hrs_sub_button = builder.get_object("initcheck_hrs_sub_button")
        self.initcheck_hrs_sub_button.connect("clicked", self.math)

        self.initcheck_mins_entry = builder.get_object("initcheck_mins_entry")
        settings.bind("initcheck-mins", self.initcheck_mins_entry, "text", Gio.SettingsBindFlags.DEFAULT)
        self.initcheck_mins_add_button = builder.get_object("initcheck_mins_add_button")
        self.initcheck_mins_add_button.connect("clicked", self.math)
        self.initcheck_mins_sub_button = builder.get_object("initcheck_mins_sub_button")
        self.initcheck_mins_sub_button.connect("clicked", self.math)

        self.repcheck_days_entry = builder.get_object("repcheck_days_entry")
        settings.bind("repcheck-days", self.repcheck_days_entry, "text", Gio.SettingsBindFlags.DEFAULT)
        self.repcheck_days_add_button = builder.get_object("repcheck_days_add_button")
        self.repcheck_days_add_button.connect("clicked", self.math)
        self.repcheck_days_sub_button = builder.get_object("repcheck_days_sub_button")
        self.repcheck_days_sub_button.connect("clicked", self.math)

        self.repcheck_hrs_entry = builder.get_object("repcheck_hrs_entry")
        settings.bind("repcheck-hrs", self.repcheck_hrs_entry, "text", Gio.SettingsBindFlags.DEFAULT)
        self.repcheck_hrs_add_button = builder.get_object("repcheck_hrs_add_button")
        self.repcheck_hrs_add_button.connect("clicked", self.math)
        self.repcheck_hrs_sub_button = builder.get_object("repcheck_hrs_sub_button")
        self.repcheck_hrs_sub_button.connect("clicked", self.math)

        self.repcheck_mins_entry = builder.get_object("repcheck_mins_entry")
        settings.bind("repcheck-mins", self.repcheck_mins_entry, "text", Gio.SettingsBindFlags.DEFAULT)
        self.repcheck_mins_add_button = builder.get_object("repcheck_mins_add_button")
        self.repcheck_mins_add_button.connect("clicked", self.math)
        self.repcheck_mins_sub_button = builder.get_object("repcheck_mins_sub_button")
        self.repcheck_mins_sub_button.connect("clicked", self.math)

        # Obtain and show the main window
        self.main_window = builder.get_object("main_window")
        self.main_window.connect("close-request", self.main_window_close_attempt)
        self.main_window.set_application(self)  # Application will close once it no longer has active windows attached to it
        self.main_window.present()

    def open_preferences_menu(self, button):
        self.main_window.set_sensitive(False)
        self.preferences_window.set_visible(True)

    def close_preferences_window(self, widget):
        self.preferences_window.set_visible(False)
        self.main_window.set_sensitive(True)

    def main_window_close_attempt(self, widget):
        if self.preferences_window.get_visible():
            return True

    def math(self, button):
        info = button.get_name().split('_')
        stage = info[0]
        time = info[1]
        action = info[2]
        if verbose:
            print(f"{stage} {time} {action}")
        num = eval(f"self.{stage}_{time}_entry.get_text()")
        print(num)
        if action == "add":
            num = int(num) + 1
        elif action == "sub":
            num = int(num) - 1
        else:
            print(f"ERROR: Unknown action '{action}'.")
        num = str(num)
        exec(f"self.{stage}_{time}_entry.set_text(num)")

app = app(application_id="net.ShockOS.UpdateManager", flags=Gio.ApplicationFlags.NON_UNIQUE)
app.run()


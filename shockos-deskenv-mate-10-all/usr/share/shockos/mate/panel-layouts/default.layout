[Toplevel toplevel-1]
enable-buttons=false
size=36
screen=0
monitor=0
expand=true
orientation=bottom

[Object object-0]
panel-right-stick=false
position=0
relative-to-edge=start
applet-iid=BriskMenuFactory::BriskMenu
locked=true
toplevel-id=toplevel-1
object-type=applet

[Object object-1]
panel-right-stick=false
position=85
relative-to-edge=start
applet-iid=WnckletFactory::ShowDesktopApplet
locked=true
toplevel-id=toplevel-1
object-type=applet

[Object object-2]
panel-right-stick=false
menu-path=applications:/
position=130
launcher-location=/usr/share/applications/chromium.desktop
relative-to-edge=start
locked=true
toplevel-id=toplevel-1
object-type=launcher


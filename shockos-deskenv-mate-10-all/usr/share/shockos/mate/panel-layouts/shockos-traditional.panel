[general]
default-layout='ubuntu'
object-id-list=['menu-bar', 'notification-area', 'clock', 'shutdown', 'show-desktop', 'window-list', 'workspace-switcher', 'trashapplet', 'object-1', 'object-2', 'object-3', 'object-4']
toplevel-id-list=['top', 'bottom']

[objects/clock]
applet-iid='ClockAppletFactory::ClockApplet'
locked=true
object-type='applet'
position=10
relative-to-edge='end'
toplevel-id='top'

[objects/clock/prefs]
custom-format=''
format='24-hour'

[objects/dockapplet/prefs]
pinned-apps=['chromium.desktop', 'caja.desktop', 'libreoffice-writer.desktop', 'mate-terminal.desktop']
win-from-cur-workspace-only=true

[objects/mcc]
launcher-location='/usr/share/applications/mageia-drakconf.desktop'
locked=true
object-type='launcher'
position=10
toplevel-id='top'

[objects/menu-bar]
locked=true
object-type='menu-bar'
position=0
toplevel-id='top'

[objects/notification-area]
applet-iid='NotificationAreaAppletFactory::NotificationArea'
locked=true
object-type='applet'
position=20
relative-to-edge='end'
toplevel-id='top'

[objects/object-0]
applet-iid='BriskMenuFactory::BriskMenu'
locked=true
object-type='applet'
panel-right-stick=false
position=0
relative-to-edge='start'
toplevel-id='toplevel-0'

[objects/object-1]
launcher-location='/usr/share/applications/chromium.desktop'
object-type='launcher'
position=258
toplevel-id='top'

[objects/object-2]
launcher-location='/usr/share/applications/caja-browser.desktop'
object-type='launcher'
position=288
toplevel-id='top'

[objects/object-3]
launcher-location='/usr/share/applications/mate-terminal.desktop'
object-type='launcher'
position=348
toplevel-id='top'

[objects/object-4]
launcher-location='/usr/share/applications/libreoffice-writer.desktop'
object-type='launcher'
position=318
toplevel-id='top'

[objects/show-desktop]
applet-iid='WnckletFactory::ShowDesktopApplet'
locked=true
object-type='applet'
position=0
toplevel-id='bottom'

[objects/shutdown]
action-type='shutdown'
locked=true
object-type='action'
position=0
relative-to-edge='end'
toplevel-id='top'

[objects/trashapplet]
applet-iid='TrashAppletFactory::TrashApplet'
locked=false
object-type='applet'
position=0
relative-to-edge='end'
toplevel-id='bottom'

[objects/window-list]
applet-iid='WnckletFactory::WindowListApplet'
locked=true
object-type='applet'
position=20
toplevel-id='bottom'

[objects/workspace-switcher]
applet-iid='WnckletFactory::WorkspaceSwitcherApplet'
locked=true
object-type='applet'
position=10
relative-to-edge='end'
toplevel-id='bottom'

[toplevels/bottom]
expand=true
orientation='bottom'
screen=0
size=24
y=1056
y-bottom=0

[toplevels/top]
expand=true
orientation='top'
screen=0
size=24

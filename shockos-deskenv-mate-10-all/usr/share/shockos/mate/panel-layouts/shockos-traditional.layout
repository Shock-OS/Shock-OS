position=10
relative-to-edge=end
applet-iid=WnckletFactory::WorkspaceSwitcherApplet
locked=true
toplevel-id=bottom
object-type=applet

[Object trashapplet]
panel-right-stick=false
position=0
relative-to-edge=end
applet-iid=TrashAppletFactory::TrashApplet
locked=false
toplevel-id=bottom
object-type=applet


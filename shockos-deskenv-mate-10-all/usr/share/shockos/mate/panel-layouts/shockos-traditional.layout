[Toplevel top]
enable-buttons=false
size=24
screen=0
monitor=0
expand=true
orientation=top

[Toplevel bottom]
enable-buttons=false
size=24
screen=0
monitor=0
expand=true
orientation=bottom

[Object menu-bar]
panel-right-stick=false
position=0
relative-to-edge=start
applet-iid=
locked=true
toplevel-id=top
object-type=menu-bar

[Object notification-area]
panel-right-stick=false
position=20
relative-to-edge=end
applet-iid=NotificationAreaAppletFactory::NotificationArea
locked=true
toplevel-id=top
object-type=applet

[Object clock]
panel-right-stick=false
position=10
relative-to-edge=end
applet-iid=ClockAppletFactory::ClockApplet
locked=true
toplevel-id=top
object-type=applet

[Object shutdown]
panel-right-stick=false
position=0
relative-to-edge=end
locked=true
toplevel-id=top
object-type=action
action-type=shutdown

[Object show-desktop]
panel-right-stick=false
position=0
relative-to-edge=start
applet-iid=WnckletFactory::ShowDesktopApplet
locked=true
toplevel-id=bottom
object-type=applet

[Object window-list]
panel-right-stick=false
position=20
relative-to-edge=start
applet-iid=WnckletFactory::WindowListApplet
locked=true
toplevel-id=bottom
object-type=applet

[Object workspace-switcher]
